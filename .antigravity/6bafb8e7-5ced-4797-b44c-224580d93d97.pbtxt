    instruction: "Apply Immersive UI dark glass theme, lime accents, and sleek tab navigation to Navbar"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  Wallet,\n  Calendar,\n  Bell,\n  Plus,\n  Download,\n  ChevronLeft,\n  ChevronRight,\n  TrendingUp,\n  Sparkles,\n  RefreshCcw,\n} from \'lucide-react\';\nimport { useExpense } from \'../context/ExpenseContext\';\nimport { getMonthName } from \'../utils/formatters\';\n\ninterface NavbarProps {\n  onOpenAddTransaction: () => void;\n  onOpenNotifications: () => void;\n  onOpenExport: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  onOpenAddTransaction,\n  onOpenNotifications,\n  onOpenExport,\n}) => {\n  const {\n    selectedMonth,\n    setSelectedMonth,\n    unreadAlertCount,\n    settings,\n    updateSettings,\n    resetToDefaultData,\n  } = useExpense();\n\n  const [showCurrencyMenu, setShowCurrencyMenu] = useState(false);\n\n  const currencies = [\n    { symbol: \'$\', code: \'USD\', label: \'$ USD (US Dollar)\' },\n    { symbol: \'\342\202\254\', code: \'EUR\', label: \'\342\202\254 EUR (Euro)\' },\n    { symbol: \'\302\243\', code: \'GBP\', label: \'\302\243 GBP (British Pound)\' },\n    { symbol: \'\342\202\271\', code: \'INR\', label: \'\342\202\271 INR (Indian Rupee)\' },\n    { symbol: \'\302\245\', code: \'JPY\', label: \'\302\245 JPY (Japanese Yen)\' },\n    { symbol: \'C$\', code: \'CAD\', label: \'C$ CAD (Canadian Dollar)\' },\n  ];\n\n  const handlePrevMonth = () => {\n    const [year, month] = selectedMonth.split(\'-\').map(Number);\n    const prevDate = new Date(year, month - 2, 1);\n    const newYear = prevDate.getFullYear();\n    const newMonth = String(prevDate.getMonth() + 1).padStart(2, \'0\');\n    setSelectedMonth(`${newYear}-${newMonth}`);\n  };\n\n  const handleNextMonth = () => {\n    const [year, month] = selectedMonth.split(\'-\').map(Number);\n    const nextDate = new Date(year, month, 1);\n    const newYear = nextDate.getFullYear();\n    const newMonth = String(nextDate.getMonth() + 1).padStart(2, \'0\');\n    setSelectedMonth(`${newYear}-${newMonth}`);\n  };\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-4\">\n          {/* Logo & Branding */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 text-white flex items-center justify-center shadow-md shadow-indigo-500/20\">\n              <Wallet className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-base font-bold tracking-tight text-slate-900 leading-tight\">\n                  OmniBudget\n                </h1>\n                <span className=\"text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200/60 uppercase\">\n                  Prorated Pro\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-500 hidden sm:block\">\n                Daily prorated limit tracker & financial analyzer\n              </p>\n            </div>\n          </div>\n\n          {/* Month Navigator */}\n          <div className=\"flex items-center bg-slate-100/90 hover:bg-slate-100 p-1 rounded-xl border border-slate-200/80 transition-colors\">\n            <button\n              id=\"prev-month-btn\"\n              onClick={handlePrevMonth}\n              title=\"Previous month\"\n              className=\"p-1.5 text-slate-600 hover:text-slate-900 hover:bg-white rounded-lg transition-all\"\n            >\n              <ChevronLeft className=\"w-4 h-4\" />\n            </button>\n            <div className=\"flex items-center gap-1.5 px-3 py-1 font-semibold text-xs sm:text-sm text-slate-800\">\n              <Calendar className=\"w-3.5 h-3.5 text-indigo-600 shrink-0\" />\n              <span className=\"min-w-[110px] text-center font-medium\">\n                {getMonthName(selectedMonth)}\n              </span>\n            </div>\n            <button\n              id=\"next-month-btn\"\n              onClick={handleNextMonth}\n              title=\"Next month\"\n              className=\"p-1.5 text-slate-600 hover:text-slate-900 hover:bg-white rounded-lg transition-all\"\n            >\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Actions & Utilities */}\n          <div className=\"flex items-center gap-2 sm:gap-2.5\">\n            {/* Currency Selector */}\n            <div className=\"relative\">\n              <button\n                id=\"currency-selector-btn\"\n                type=\"button\"\n                onClick={() => setShowCurrencyMenu(!showCurrencyMenu)}\n                className=\"px-2.5 py-1.5 text-xs font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl transition-colors flex items-center gap-1\"\n                title=\"Change Currency\"\n              >\n                <span className=\"text-indigo-600 font-bold\">{settings.currency}</span>\n                <span className=\"text-slate-500 text-[11px]\">{settings.currencyCode}</span>\n              </button>\n\n              {showCurrencyMenu && (\n                <div className=\"absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-100 p-1 z-50\">\n                  <div className=\"text-[10px] uppercase font-bold text-slate-400 px-2 py-1\">\n                    Select Currency\n                  </div>\n                  {currencies.map((c) => (\n                    <button\n                      key={c.code}\n                      onClick={() => {\n                        updateSettings({ currency: c.symbol, currencyCode: c.code });\n                        setShowCurrencyMenu(false);\n                      }}\n                      className={`w-full text-left px-2.5 py-1.5 text-xs rounded-lg transition-colors flex items-center justify-between ${\n                        settings.currencyCode === c.code\n                          ? \'bg-indigo-50 text-indigo-700 font-semibold\'\n                          : \'text-slate-700 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>{c.label}</span>\n                      <span className=\"font-bold\">{c.symbol}</span>\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Export CSV Button */}\n            <button\n              id=\"navbar-export-btn\"\n              type=\"button\"\n              onClick={onOpenExport}\n              className=\"px-2.5 sm:px-3 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl shadow-2xs transition-colors flex items-center gap-1.5\"\n              title=\"Export CSV Reports\"\n            >\n              <Download className=\"w-3.5 h-3.5 text-slate-500\" />\n              <span className=\"hidden md:inline\">Export CSV</span>\n            </button>\n\n            {/* Notification Bell with Badge */}\n            <button\n              id=\"navbar-notifications-btn\"\n              type=\"button\"\n              onClick={onOpenNotifications}\n              className=\"relative p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors\"\n              title=\"View Budget Alerts\"\n            >\n              <Bell className=\"w-4 h-4\" />\n              {unreadAlertCount > 0 && (\n                <span className=\"absolute -top-0.5 -right-0.5 w-4 h-4 bg-rose-500 text-white rounded-full text-[10px] font-bold flex items-center justify-center animate-pulse shadow-xs\">\n                  {unreadAlertCount}\n                </span>\n              )}\n            </button>\n\n            {/* Primary Add Transaction Button */}\n            <button\n              id=\"navbar-add-tx-btn\"\n              type=\"button\"\n              onClick={onOpenAddTransaction}\n              className=\"px-3 sm:px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Log Expense</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  Wallet,\n  Calendar,\n  Bell,\n  Plus,\n  Download,\n  ChevronLeft,\n  ChevronRight,\n  LayoutDashboard,\n  Calculator,\n  ReceiptText,\n  PieChart,\n  Repeat,\n  Target,\n  Settings,\n} from \'lucide-react\';\nimport { useExpense } from \'../context/ExpenseContext\';\nimport { getMonthName } from \'../utils/formatters\';\n\ninterface NavbarProps {\n  activeTab: string;\n  onTabChange: (tab: string) => void;\n  onOpenAddTransaction: () => void;\n  onOpenNotifications: () => void;\n  onOpenExport: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  onTabChange,\n  onOpenAddTransaction,\n  onOpenNotifications,\n  onOpenExport,\n}) => {\n  const {\n    selectedMonth,\n    setSelectedMonth,\n    unreadAlertCount,\n    settings,\n    updateSettings,\n  } = useExpense();\n\n  const [showCurrencyMenu, setShowCurrencyMenu] = useState(false);\n\n  const currencies = [\n    { symbol: \'$\', code: \'USD\', label: \'$ USD (US Dollar)\' },\n    { symbol: \'\342\202\254\', code: \'EUR\', label: \'\342\202\254 EUR (Euro)\' },\n    { symbol: \'\302\243\', code: \'GBP\', label: \'\302\243 GBP (British Pound)\' },\n    { symbol: \'\342\202\271\', code: \'INR\', label: \'\342\202\271 INR (Indian Rupee)\' },\n    { symbol: \'\302\245\', code: \'JPY\', label: \'\302\245 JPY (Japanese Yen)\' },\n    { symbol: \'C$\', code: \'CAD\', label: \'C$ CAD (Canadian Dollar)\' },\n  ];\n\n  const handlePrevMonth = () => {\n    const [year, month] = selectedMonth.split(\'-\').map(Number);\n    const prevDate = new Date(year, month - 2, 1);\n    const newYear = prevDate.getFullYear();\n    const newMonth = String(prevDate.getMonth() + 1).padStart(2, \'0\');\n    setSelectedMonth(`${newYear}-${newMonth}`);\n  };\n\n  const handleNextMonth = () => {\n    const [year, month] = selectedMonth.split(\'-\').map(Number);\n    const nextDate = new Date(year, month, 1);\n    const newYear = nextDate.getFullYear();\n    const newMonth = String(nextDate.getMonth() + 1).padStart(2, \'0\');\n    setSelectedMonth(`${newYear}-${newMonth}`);\n  };\n\n  const navTabs = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'prorated\', label: \'Prorated Limits\', icon: Calculator, badge: \'Daily\' },\n    { id: \'transactions\', label: \'Transactions\', icon: ReceiptText },\n    { id: \'reports\', label: \'Reports\', icon: PieChart },\n    { id: \'budgets\', label: \'Budgets & Recurring\', icon: Repeat },\n    { id: \'savings_debt\', label: \'Savings & Debt\', icon: Target },\n    { id: \'settings\', label: \'Categories\', icon: Settings },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#09090b]/90 backdrop-blur-xl border-b border-white/[0.08]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Top bar */}\n        <div className=\"flex items-center justify-between h-16 gap-4\">\n          {/* Logo & Branding */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-zinc-800 to-zinc-900 border border-white/10 text-[#c1ff72] flex items-center justify-center shadow-[0_0_12px_rgba(193,255,114,0.15)]\">\n              <Wallet className=\"w-5 h-5 text-[#c1ff72]\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-base font-extrabold tracking-tight text-white leading-tight\">\n                  FINANCE<span className=\"text-[#c1ff72]\">FLOW</span>\n                </h1>\n                <span className=\"text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#c1ff72]/10 text-[#c1ff72] border border-[#c1ff72]/20 uppercase\">\n                  PRORATED\n                </span>\n              </div>\n              <p className=\"text-[10px] uppercase tracking-widest text-zinc-400 hidden sm:block\">\n                Atmospheric Expense Monitoring \342\200\242 {getMonthName(selectedMonth)}\n              </p>\n            </div>\n          </div>\n\n          {/* Month Navigator */}\n          <div className=\"flex items-center bg-[#111114] p-1 rounded-xl border border-white/[0.08] shadow-inner\">\n            <button\n              id=\"prev-month-btn\"\n              onClick={handlePrevMonth}\n              title=\"Previous month\"\n              className=\"p-1.5 text-zinc-400 hover:text-white hover:bg-white/5 rounded-lg transition-all\"\n            >\n              <ChevronLeft className=\"w-4 h-4\" />\n            </button>\n            <div className=\"flex items-center gap-1.5 px-3 py-1 font-semibold text-xs sm:text-sm text-zinc-200\">\n              <Calendar className=\"w-3.5 h-3.5 text-[#c1ff72] shrink-0\" />\n              <span className=\"min-w-[100px] text-center font-mono text-xs sm:text-sm\">\n                {getMonthName(selectedMonth)}\n              </span>\n            </div>\n            <button\n              id=\"next-month-btn\"\n              onClick={handleNextMonth}\n              title=\"Next month\"\n              className=\"p-1.5 text-zinc-400 hover:text-white hover:bg-white/5 rounded-lg transition-all\"\n            >\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Actions & Utilities */}\n          <div className=\"flex items-center gap-2 sm:gap-2.5\">\n            {/* Currency Selector */}\n            <div className=\"relative\">\n              <button\n                id=\"currency-selector-btn\"\n                type=\"button\"\n                onClick={() => setShowCurrencyMenu(!showCurrencyMenu)}\n                className=\"px-2.5 py-1.5 text-xs font-semibold text-zinc-300 bg-[#111114] hover:bg-white/5 border border-white/[0.08] rounded-xl transition-colors flex items-center gap-1.5\"\n                title=\"Change Currency\"\n              >\n                <span className=\"text-[#c1ff72] font-mono font-bold\">{settings.currency}</span>\n                <span className=\"text-zinc-500 text-[10px] font-mono\">{settings.currencyCode}</span>\n              </button>\n\n              {showCurrencyMenu && (\n                <div className=\"absolute right-0 mt-2 w-48 bg-[#111114] rounded-xl shadow-2xl border border-white/10 p-1.5 z-50 backdrop-blur-xl\">\n                  <div className=\"text-[10px] uppercase font-bold tracking-wider text-zinc-500 px-2 py-1\">\n                    Select Currency\n                  </div>\n                  {currencies.map((c) => (\n                    <button\n                      key={c.code}\n                      onClick={() => {\n                        updateSettings({ currency: c.symbol, currencyCode: c.code });\n                        setShowCurrencyMenu(false);\n                      }}\n                      className={`w-full text-left px-2.5 py-1.5 text-xs rounded-lg transition-colors flex items-center justify-between ${\n                        settings.currencyCode === c.code\n                          ? \'bg-[#c1ff72]/15 text-[#c1ff72] font-semibold\'\n                          : \'text-zinc-300 hover:bg-white/5\'\n                      }`}\n                    >\n                      <span>{c.label}</span>\n                      <span className=\"font-mono font-bold text-[#c1ff72]\">{c.symbol}</span>\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Export CSV Button */}\n            <button\n              id=\"navbar-export-btn\"\n              type=\"button\"\n              onClick={onOpenExport}\n              className=\"px-3 py-1.5 text-xs font-semibold text-zinc-300 hover:text-white bg-[#111114] hover:bg-white/5 border border-white/[0.08] rounded-xl transition-all flex items-center gap-1.5\"\n              title=\"Export CSV Reports\"\n            >\n              <Download className=\"w-3.5 h-3.5 text-zinc-400\" />\n              <span className=\"hidden md:inline uppercase text-[11px] tracking-wider\">Export CSV</span>\n            </button>\n\n            {/* Notification Bell with Badge */}\n            <button\n              id=\"navbar-notifications-btn\"\n              type=\"button\"\n              onClick={onOpenNotifications}\n              className=\"relative p-2 text-zinc-400 hover:text-white hover:bg-white/5 rounded-xl border border-transparent hover:border-white/[0.08] transition-colors\"\n              title=\"View Budget Alerts\"\n            >\n              <Bell className=\"w-4 h-4\" />\n              {unreadAlertCount > 0 && (\n                <span className=\"absolute -top-0.5 -right-0.5 w-4 h-4 bg-[#ff5f5f] text-black font-mono rounded-full text-[10px] font-black flex items-center justify-center shadow-[0_0_8px_rgba(255,95,95,0.6)]\">\n                  {unreadAlertCount}\n                </span>\n              )}\n            </button>\n\n            {/* Primary Add Transaction Button */}\n            <button\n              id=\"navbar-add-tx-btn\"\n              type=\"button\"\n              onClick={onOpenAddTransaction}\n              className=\"px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs font-bold text-black bg-[#c1ff72] hover:bg-[#b0f05f] rounded-xl shadow-[0_0_15px_rgba(193,255,114,0.3)] hover:shadow-[0_0_20px_rgba(193,255,114,0.45)] transition-all flex items-center gap-1.5 shrink-0\"\n            >\n              <Plus className=\"w-4 h-4 text-black\" />\n              <span className=\"uppercase tracking-wider text-[11px]\">Add Transaction</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Sub-navigation Tab Bar */}\n        <div className=\"flex items-center gap-1 overflow-x-auto py-2 border-t border-white/[0.06] no-scrollbar\">\n          {navTabs.map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                id={`tab-${tab.id}`}\n                onClick={() => onTabChange(tab.id)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all flex items-center gap-2 ${\n                  isActive\n                    ? \'bg-[#c1ff72]/15 text-[#c1ff72] border border-[#c1ff72]/30 shadow-[0_0_10px_rgba(193,255,114,0.1)]\'\n                    : \'text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.04] border border-transparent\'\n                }`}\n              >\n                <Icon className={`w-3.5 h-3.5 ${isActive ? \'text-[#c1ff72]\' : \'text-zinc-500\'}`} />\n                <span>{tab.label}</span>\n                {tab.badge && (\n                  <span className=\"text-[9px] font-mono uppercase px-1 py-0.2 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30\">\n                    {tab.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
