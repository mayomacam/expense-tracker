  file_change {
    absolute_path_uri: "file:///src/components/views/MonthlyReportView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useMemo } from \'react\';\nimport {\n  ResponsiveContainer,\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  Tooltip,\n  CartesianGrid,\n  Legend,\n} from \'recharts\';\nimport {\n  FileText,\n  Download,\n  Printer,\n  TrendingUp,\n  PieChart as PieIcon,\n  CheckCircle2,\n  AlertCircle,\n  Calendar,\n  Layers,\n  Sparkles,\n} from \'lucide-react\';\nimport { useExpense } from \'../../context/ExpenseContext\';\nimport { formatCurrency, getMonthName, getDaysInMonth } from \'../../utils/formatters\';\nimport { CategoryIcon } from \'../common/CategoryIcon\';\nimport { calculateProratedDailyBreakdown } from \'../../utils/budgetCalculations\';\n\ninterface MonthlyReportViewProps {\n  onOpenExport: () => void;\n}\n\nexport const MonthlyReportView: React.FC<MonthlyReportViewProps> = ({ onOpenExport }) => {\n  const {\n    transactions,\n    categories,\n    proratedRules,\n    selectedMonth,\n    settings,\n  } = useExpense();\n\n  const daysInMon = getDaysInMonth(selectedMonth);\n\n  // Month transactions\n  const monthTransactions = useMemo(() => {\n    return transactions.filter((t) => t.date.startsWith(selectedMonth));\n  }, [transactions, selectedMonth]);\n\n  // Financial calculations\n  const report = useMemo(() => {\n    let totalIncome = 0;\n    let totalExpense = 0;\n    const catMap: Record<string, { spent: number; budget: number }> = {};\n\n    categories.forEach((c) => {\n      catMap[c.id] = { spent: 0, budget: c.monthlyBudget || 0 };\n    });\n\n    monthTransactions.forEach((t) => {\n      if (t.type === \'income\') {\n        totalIncome += t.amount;\n      } else {\n        totalExpense += t.amount;\n        if (!catMap[t.category]) {\n          catMap[t.category] = { spent: 0, budget: 0 };\n        }\n        catMap[t.category].spent += t.amount;\n      }\n    });\n\n    const netSavings = totalIncome - totalExpense;\n    const savingsRate = totalIncome > 0 ? (netSavings / totalIncome) * 100 : 0;\n    const totalBudget = categories.reduce((sum, c) => sum + (c.monthlyBudget || 0), 0);\n    const dailyAverage = totalExpense / daysInMon;\n\n    // Category breakdown list\n    const categoryBreakdown = categories\n      .map((cat) => {\n        const spent = catMap[cat.id]?.spent || 0;\n        const budget = cat.monthlyBudget || 0;\n        const diff = budget > 0 ? budget - spent : 0;\n        const percentUsed = budget > 0 ? (spent / budget) * 100 : 0;\n        return {\n          cat,\n          spent,\n          budget,\n          diff,\n          percentUsed,\n          isOver: budget > 0 && spent > budget,\n        };\n      })\n      .filter((item) => item.spent > 0 || item.budget > 0);\n\n    return {\n      totalIncome,\n      totalExpense,\n      netSavings,\n      savingsRate,\n      totalBudget,\n      dailyAverage,\n      categoryBreakdown,\n    };\n  }, [monthTransactions, categories, daysInMon]);\n\n  // Cashflow comparison bar chart data\n  const comparisonData = useMemo(() => {\n    return [\n      {\n        name: getMonthName(selectedMonth),\n        Income: Number(report.totalIncome.toFixed(2)),\n        Expenses: Number(report.totalExpense.toFixed(2)),\n        NetSavings: Number(report.netSavings.toFixed(2)),\n      },\n    ];\n  }, [report, selectedMonth]);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header & Export Actions */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-200\">\n              Executive Statement\n            </span>\n            <span className=\"text-xs text-slate-400\">\342\200\242</span>\n            <span className=\"text-xs font-medium text-slate-500\">\n              {getMonthName(selectedMonth)}\n            </span>\n          </div>\n          <h2 className=\"text-xl font-bold text-slate-900 mt-1\">\n            Month-Wise Comprehensive Financial Report\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Full breakdown of income, expenses, category budget adherence, and prorated tracking\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => window.print()}\n            className=\"px-3 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5\"\n            title=\"Print or Save PDF\"\n          >\n            <Printer className=\"w-3.5 h-3.5\" />\n            <span>Print View</span>\n          </button>\n          <button\n            type=\"button\"\n            id=\"report-export-csv-btn\"\n            onClick={onOpenExport}\n            className=\"px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Export Statement (CSV)</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Financial Executive Summary Cards */}\n      <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 block mb-1\">Total Inflow</span>\n          <div className=\"text-2xl font-bold text-emerald-600\">\n            {formatCurrency(report.totalIncome, settings.currency)}\n          </div>\n          <span className=\"text-[11px] text-slate-400 mt-1 block\">Monthly income earned</span>\n        </div>\n\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 block mb-1\">Total Outflow</span>\n          <div className=\"text-2xl font-bold text-slate-900\">\n            {formatCurrency(report.totalExpense, settings.currency)}\n          </div>\n          <span className=\"text-[11px] text-slate-400 mt-1 block\">\n            Avg: {formatCurrency(report.dailyAverage, settings.currency)} / day\n          </span>\n        </div>\n\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 block mb-1\">Net Savings</span>\n          <div\n            className={`text-2xl font-bold ${\n              report.netSavings >= 0 ? \'text-indigo-600\' : \'text-rose-600\'\n            }`}\n          >\n            {formatCurrency(report.netSavings, settings.currency)}\n          </div>\n          <span className=\"text-[11px] text-slate-400 mt-1 block\">\n            {report.netSavings >= 0 ? \'Surplus retained\' : \'Operating deficit\'}\n          </span>\n        </div>\n\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 block mb-1\">Savings Rate</span>\n          <div className=\"text-2xl font-bold text-indigo-900\">\n            {report.savingsRate > 0 ? `${report.savingsRate.toFixed(1)}%` : \'0.0%\'}\n          </div>\n          <span className=\"text-[11px] text-slate-400 mt-1 block\">\n            Target benchmark: 20%+\n          </span>\n        </div>\n      </div>\n\n      {/* Cashflow Comparison Chart */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-xs\">\n        <h3 className=\"text-base font-bold text-slate-900 mb-1\">\n          Monthly Inflow vs Outflow Comparison\n        </h3>\n        <p className=\"text-xs text-slate-500 mb-4\">\n          Visual comparison of total monthly income, expenditure, and retained savings\n        </p>\n\n        <div className=\"h-56 w-full\">\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\n            <BarChart data={comparisonData} margin={{ top: 10, right: 30, left: 0, bottom: 0 }}>\n              <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f1f5f9\" vertical={false} />\n              <XAxis dataKey=\"name\" tickLine={false} tick={{ fontSize: 12, fill: \'#64748b\' }} />\n              <YAxis\n                tickLine={false}\n                tick={{ fontSize: 11, fill: \'#64748b\' }}\n                tickFormatter={(v) => `${settings.currency}${v}`}\n              />\n              <Tooltip formatter={(val: number) => [formatCurrency(val, settings.currency)]} />\n              <Legend wrapperStyle={{ fontSize: \'12px\', paddingTop: \'10px\' }} />\n              <Bar dataKey=\"Income\" fill=\"#10b981\" radius={[4, 4, 0, 0]} />\n              <Bar dataKey=\"Expenses\" fill=\"#f43f5e\" radius={[4, 4, 0, 0]} />\n              <Bar dataKey=\"NetSavings\" fill=\"#6366f1\" radius={[4, 4, 0, 0]} />\n            </BarChart>\n          </ResponsiveContainer>\n        </div>\n      </div>\n\n      {/* Prorated Daily Rules in Statement */}\n      {proratedRules.length > 0 && (\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-xs\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Prorated Daily Spend Allocations\n              </h3>\n              <p className=\"text-xs text-slate-500\">\n                Items tracked on a daily prorated ceiling basis\n              </p>\n            </div>\n            <span className=\"text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200\">\n              {proratedRules.length} tracked items\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {proratedRules.map((rule) => {\n              const ruleBreakdown = calculateProratedDailyBreakdown(\n                rule,\n                transactions,\n                selectedMonth\n              );\n              const pct = (ruleBreakdown.totalSpentSoFar / ruleBreakdown.effectiveMonthlyBudget) * 100;\n              return (\n                <div\n                  key={rule.id}\n                  className=\"p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <h4 className=\"text-sm font-bold text-slate-900\">{rule.name}</h4>\n                      <span className=\"text-[11px] text-slate-500\">\n                        Daily Limit: {formatCurrency(ruleBreakdown.dailyProratedLimit, settings.currency)} / day\n                      </span>\n                    </div>\n                    <div className=\"text-right\">\n                      <span className=\"text-sm font-bold text-slate-900\">\n                        {formatCurrency(ruleBreakdown.totalSpentSoFar, settings.currency)}\n                      </span>\n                      <span className=\"text-[11px] text-slate-400 block\">\n                        of {formatCurrency(ruleBreakdown.effectiveMonthlyBudget, settings.currency)} cap\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Progress bar */}\n                  <div className=\"w-full bg-slate-200 rounded-full h-2 overflow-hidden\">\n                    <div\n                      className={`h-full rounded-full ${\n                        pct > 100 ? \'bg-rose-500\' : \'bg-amber-500\'\n                      }`}\n                      style={{ width: `${Math.min(100, pct)}%` }}\n                    />\n                  </div>\n\n                  <div className=\"flex items-center justify-between text-[11px] text-slate-500 pt-1\">\n                    <span>\n                      {ruleBreakdown.exceededDaysCount > 0\n                        ? `${ruleBreakdown.exceededDaysCount} days over daily limit`\n                        : \'Zero over-limit days\'}\n                    </span>\n                    <span className=\"font-semibold text-slate-700\">{pct.toFixed(0)}% used</span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* Category Allocation vs Actual Adherence Matrix */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n        <div className=\"p-5 border-b border-slate-100\">\n          <h3 className=\"text-base font-bold text-slate-900\">\n            Category Budget Performance Matrix\n          </h3>\n          <p className=\"text-xs text-slate-500\">\n            Detailed breakdown of allocated budget vs actual spending per category\n          </p>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 text-slate-600 font-semibold border-b border-slate-200\">\n              <tr>\n                <th className=\"py-3 px-4\">Category</th>\n                <th className=\"py-3 px-4\">Allocated Budget</th>\n                <th className=\"py-3 px-4\">Actual Spent</th>\n                <th className=\"py-3 px-4\">Variance / Remaining</th>\n                <th className=\"py-3 px-4\">Progress</th>\n                <th className=\"py-3 px-4 text-center\">Status</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {report.categoryBreakdown.map(({ cat, spent, budget, diff, percentUsed, isOver }) => {\n                return (\n                  <tr key={cat.id} className=\"hover:bg-slate-50/80 transition-colors\">\n                    <td className=\"py-3 px-4\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <div\n                          className=\"w-7 h-7 rounded-lg flex items-center justify-center text-white shrink-0\"\n                          style={{ backgroundColor: cat.color }}\n                        >\n                          <CategoryIcon name={cat.icon} className=\"w-3.5 h-3.5\" />\n                        </div>\n                        <span className=\"font-bold text-slate-900\">{cat.name}</span>\n                      </div>\n                    </td>\n\n                    <td className=\"py-3 px-4 text-slate-600 font-medium\">\n                      {budget > 0 ? formatCurrency(budget, settings.currency) : \'No Cap\'}\n                    </td>\n\n                    <td className=\"py-3 px-4 font-bold text-slate-900\">\n                      {formatCurrency(spent, settings.currency)}\n                    </td>\n\n                    <td className=\"py-3 px-4 font-semibold\">\n                      {budget > 0 ? (\n                        <span className={diff >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}>\n                          {diff >= 0 ? \'+\' : \'\'}\n                          {formatCurrency(diff, settings.currency)}\n                        </span>\n                      ) : (\n                        <span className=\"text-slate-400\">\342\200\224</span>\n                      )}\n                    </td>\n\n                    <td className=\"py-3 px-4 min-w-[120px]\">\n                      {budget > 0 ? (\n                        <div className=\"space-y-1\">\n                          <div className=\"w-full bg-slate-100 rounded-full h-1.5 overflow-hidden\">\n                            <div\n                              className={`h-full rounded-full ${\n                                isOver\n                                  ? \'bg-rose-500\'\n                                  : percentUsed > 80\n                                  ? \'bg-amber-500\'\n                                  : \'bg-emerald-500\'\n                              }`}\n                              style={{ width: `${Math.min(100, percentUsed)}%` }}\n                            />\n                          </div>\n                          <span className=\"text-[10px] text-slate-400\">\n                            {percentUsed.toFixed(0)}%\n                          </span>\n                        </div>\n                      ) : (\n                        <span className=\"text-slate-400 text-[10px]\">\342\200\224</span>\n                      )}\n                    </td>\n\n                    <td className=\"py-3 px-4 text-center whitespace-nowrap\">\n                      {budget === 0 ? (\n                        <span className=\"px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-600\">\n                          Unbudgeted\n                        </span>\n                      ) : isOver ? (\n                        <span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200\">\n                          Over Budget\n                        </span>\n                      ) : (\n                        <span className=\"px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-100 text-emerald-700 border border-emerald-200\">\n                          On Track\n                        </span>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
