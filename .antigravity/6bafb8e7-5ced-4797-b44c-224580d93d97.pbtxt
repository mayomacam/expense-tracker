  file_change {
    absolute_path_uri: "file:///src/components/views/ProratedBudgetView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport {\n  ResponsiveContainer,\n  LineChart,\n  Line,\n  XAxis,\n  YAxis,\n  Tooltip,\n  CartesianGrid,\n  ReferenceLine,\n  Area,\n  ComposedChart,\n  Bar,\n} from \'recharts\';\nimport {\n  Calculator,\n  AlertTriangle,\n  CheckCircle2,\n  TrendingUp,\n  ArrowRightLeft,\n  Plus,\n  Edit2,\n  Trash2,\n  Calendar,\n  AlertCircle,\n  Sparkles,\n  Info,\n  Cookie,\n  Coffee,\n} from \'lucide-react\';\nimport { useExpense } from \'../../context/ExpenseContext\';\nimport { ProratedBudgetRule, Transaction } from \'../../types\';\nimport { calculateProratedDailyBreakdown } from \'../../utils/budgetCalculations\';\nimport { formatCurrency, getMonthName } from \'../../utils/formatters\';\nimport { CategoryIcon } from \'../common/CategoryIcon\';\n\ninterface ProratedBudgetViewProps {\n  onOpenAddTransaction: (defaultCategory?: string) => void;\n  onOpenAddProratedModal: () => void;\n  onEditProratedRule: (rule: ProratedBudgetRule) => void;\n}\n\nexport const ProratedBudgetView: React.FC<ProratedBudgetViewProps> = ({\n  onOpenAddTransaction,\n  onOpenAddProratedModal,\n  onEditProratedRule,\n}) => {\n  const {\n    proratedRules,\n    transactions,\n    categories,\n    selectedMonth,\n    deleteProratedRule,\n    deleteTransaction,\n    settings,\n  } = useExpense();\n\n  const [selectedRuleId, setSelectedRuleId] = useState<string>(\n    proratedRules[0]?.id || \'\'\n  );\n  const [chartMode, setChartMode] = useState<\'cumulative\' | \'daily\'>(\'daily\');\n\n  // Selected Rule\n  const activeRule = useMemo(() => {\n    return proratedRules.find((r) => r.id === selectedRuleId) || proratedRules[0] || null;\n  }, [proratedRules, selectedRuleId]);\n\n  // Breakdown calculations\n  const breakdown = useMemo(() => {\n    if (!activeRule) return null;\n    return calculateProratedDailyBreakdown(activeRule, transactions, selectedMonth);\n  }, [activeRule, transactions, selectedMonth]);\n\n  // Chart Data\n  const chartData = useMemo(() => {\n    if (!breakdown) return [];\n    return breakdown.dailyRecords.map((r) => ({\n      dayLabel: `Day ${r.day}`,\n      day: r.day,\n      date: r.date,\n      dayOfWeek: r.dayOfWeek,\n      dailySpend: r.amountSpent,\n      dailyLimit: r.dailyProratedLimit,\n      cumulativeSpend: r.cumulativeSpent,\n      cumulativeLimit: r.cumulativeProratedLimit,\n      isOver: r.isOverLimit,\n      delta: r.delta,\n    }));\n  }, [breakdown]);\n\n  if (proratedRules.length === 0 || !activeRule || !breakdown) {\n    return (\n      <div className=\"bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-xs max-w-2xl mx-auto my-8\">\n        <div className=\"w-16 h-16 rounded-2xl bg-amber-100 text-amber-600 mx-auto flex items-center justify-center mb-4\">\n          <Calculator className=\"w-8 h-8\" />\n        </div>\n        <h3 className=\"text-lg font-bold text-slate-900\">\n          No Prorated Daily Spending Limits Set\n        </h3>\n        <p className=\"text-sm text-slate-500 mt-2 max-w-md mx-auto\">\n          Track specific expenses (like Snacks, Coffee, or Dining Out) by setting a monthly max\n          spend that divides evenly across all days in the month with automated overspend alerts.\n        </p>\n        <button\n          id=\"empty-add-prorated-btn\"\n          type=\"button\"\n          onClick={onOpenAddProratedModal}\n          className=\"mt-6 px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-xl shadow-xs inline-flex items-center gap-2 transition-colors\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          Create Prorated Tracker (e.g. Snacks $500/mo)\n        </button>\n      </div>\n    );\n  }\n\n  const linkedCategory = categories.find((c) => c.id === activeRule.categoryId);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner / Item Selector */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200\">\n              Prorated Spending Engine\n            </span>\n            <span className=\"text-xs text-slate-400\">\342\200\242</span>\n            <span className=\"text-xs font-medium text-slate-500\">\n              {getMonthName(selectedMonth)} ({breakdown.daysInMonth} days)\n            </span>\n          </div>\n          <h2 className=\"text-xl font-bold text-slate-900 mt-1\">\n            {activeRule.name} Daily Limit & Tracking\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Monthly max spend of {formatCurrency(activeRule.monthlyMaxSpend, settings.currency)} divided into{\' \'}\n            <strong className=\"text-amber-700\">\n              {formatCurrency(breakdown.dailyProratedLimit, settings.currency)} / day\n            </strong>\n          </p>\n        </div>\n\n        {/* Rule Switcher & Manage Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          {proratedRules.length > 1 && (\n            <select\n              id=\"select-prorated-rule-dropdown\"\n              value={selectedRuleId}\n              onChange={(e) => setSelectedRuleId(e.target.value)}\n              className=\"px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-amber-500\"\n            >\n              {proratedRules.map((r) => (\n                <option key={r.id} value={r.id}>\n                  {r.name} ({formatCurrency(r.monthlyMaxSpend, settings.currency)}/mo)\n                </option>\n              ))}\n            </select>\n          )}\n\n          <button\n            id=\"edit-active-prorated-btn\"\n            type=\"button\"\n            onClick={() => onEditProratedRule(activeRule)}\n            className=\"p-2 text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200/80 rounded-xl text-xs font-medium transition-colors\"\n            title=\"Edit rule settings\"\n          >\n            <Edit2 className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            id=\"add-another-prorated-btn\"\n            type=\"button\"\n            onClick={onOpenAddProratedModal}\n            className=\"px-3 py-2 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-colors\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>New Tracker</span>\n          </button>\n\n          <button\n            id=\"log-snack-spend-btn\"\n            type=\"button\"\n            onClick={() => onOpenAddTransaction(activeRule.categoryId)}\n            className=\"px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-semibold shadow-xs flex items-center gap-1.5 transition-colors\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Log {activeRule.name} Spend</span>\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Cards Grid */}\n      <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Daily Prorated Allowance */}\n        <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Daily Prorated Limit</span>\n            <Calculator className=\"w-4 h-4 text-amber-500\" />\n          </div>\n          <div className=\"text-2xl font-bold text-amber-900\">\n            {formatCurrency(breakdown.dailyProratedLimit, settings.currency)}\n          </div>\n          <div className=\"text-[11px] text-slate-400 mt-1 flex items-center gap-1\">\n            <span>{formatCurrency(breakdown.effectiveMonthlyBudget, settings.currency)} \303\267 {breakdown.daysInMonth} days</span>\n          </div>\n          <div className=\"absolute right-0 bottom-0 translate-x-2 translate-y-2 opacity-5 pointer-events-none\">\n            <Calculator className=\"w-20 h-20 text-amber-900\" />\n          </div>\n        </div>\n\n        {/* Total Spent vs Budget */}\n        <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Total Spent / Budget</span>\n            <TrendingUp className=\"w-4 h-4 text-indigo-500\" />\n          </div>\n          <div className=\"text-2xl font-bold text-slate-900\">\n            {formatCurrency(breakdown.totalSpentSoFar, settings.currency)}\n          </div>\n          <div className=\"text-[11px] text-slate-500 mt-1 flex items-center justify-between\">\n            <span>Cap: {formatCurrency(breakdown.effectiveMonthlyBudget, settings.currency)}</span>\n            <span\n              className={`font-semibold ${\n                breakdown.remainingBudget >= 0 ? \'text-emerald-600\' : \'text-rose-600 font-bold\'\n              }`}\n            >\n              {breakdown.remainingBudget >= 0\n                ? `${formatCurrency(breakdown.remainingBudget, settings.currency)} left`\n                : `${formatCurrency(Math.abs(breakdown.remainingBudget), settings.currency)} OVER`}\n            </span>\n          </div>\n        </div>\n\n        {/* Over-Limit Days */}\n        <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Over-Limit Days</span>\n            <AlertTriangle className={`w-4 h-4 ${breakdown.exceededDaysCount > 0 ? \'text-rose-500\' : \'text-emerald-500\'}`} />\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span\n              className={`text-2xl font-bold ${\n                breakdown.exceededDaysCount > 0 ? \'text-rose-600\' : \'text-emerald-600\'\n              }`}\n            >\n              {breakdown.exceededDaysCount}\n            </span>\n            <span className=\"text-xs text-slate-500 font-medium\">\n              out of {breakdown.daysPassed} days tracked\n            </span>\n          </div>\n          <div className=\"text-[11px] text-slate-400 mt-1\">\n            {breakdown.maxDaySpent.amount > 0 ? (\n              <span>Peak: {formatCurrency(breakdown.maxDaySpent.amount, settings.currency)} (Day {breakdown.maxDaySpent.day})</span>\n            ) : (\n              <span>No recorded spend yet</span>\n            )}\n          </div>\n        </div>\n\n        {/* Rollover & Projected */}\n        <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Rollover & Pace</span>\n            <ArrowRightLeft className=\"w-4 h-4 text-purple-500\" />\n          </div>\n          <div className=\"text-2xl font-bold text-slate-900\">\n            {formatCurrency(breakdown.averageDailySpend, settings.currency)}\n            <span className=\"text-xs text-slate-400 font-normal ml-1\">/ day avg</span>\n          </div>\n          <div className=\"text-[11px] text-slate-500 mt-1 flex items-center justify-between\">\n            <span>\n              {activeRule.rolloverEnabled\n                ? `Rollover: ${activeRule.rolloverAmount > 0 ? \'+\' : \'\'}${formatCurrency(\n                    activeRule.rolloverAmount,\n                    settings.currency\n                  )}`\n                : \'Rollover Off\'}\n            </span>\n            <span className=\"text-purple-600 font-medium\">\n              Pace: {formatCurrency(breakdown.projectedMonthEndSpend, settings.currency)}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Visual Chart: Actual Spending vs Daily Limit */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Whole Month Spending vs. Daily Limit Curve\n              </h3>\n              <span className=\"px-2 py-0.5 text-[10px] font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200\">\n                Interactive Graph\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Visual comparison of actual daily expenditure against the calculated prorated limit\n            </p>\n          </div>\n\n          {/* Toggle between Daily and Cumulative View */}\n          <div className=\"flex bg-slate-100 p-1 rounded-xl\">\n            <button\n              id=\"chart-mode-daily-btn\"\n              type=\"button\"\n              onClick={() => setChartMode(\'daily\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${\n                chartMode === \'daily\'\n                  ? \'bg-white text-amber-700 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Daily Spending Bars\n            </button>\n            <button\n              id=\"chart-mode-cumulative-btn\"\n              type=\"button\"\n              onClick={() => setChartMode(\'cumulative\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${\n                chartMode === \'cumulative\'\n                  ? \'bg-white text-indigo-700 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Cumulative Trend Line\n            </button>\n          </div>\n        </div>\n\n        {/* Recharts Container */}\n        <div className=\"h-72 w-full\">\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\n            {chartMode === \'daily\' ? (\n              <ComposedChart data={chartData} margin={{ top: 10, right: 10, left: -10, bottom: 0 }}>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f1f5f9\" vertical={false} />\n                <XAxis\n                  dataKey=\"day\"\n                  tickLine={false}\n                  axisLine={{ stroke: \'#e2e8f0\' }}\n                  tick={{ fontSize: 11, fill: \'#64748b\' }}\n                  tickFormatter={(v) => `D${v}`}\n                />\n                <YAxis\n                  tickLine={false}\n                  axisLine={{ stroke: \'#e2e8f0\' }}\n                  tick={{ fontSize: 11, fill: \'#64748b\' }}\n                  tickFormatter={(v) => `${settings.currency}${v}`}\n                />\n                <Tooltip\n                  content={({ active, payload }) => {\n                    if (active && payload && payload.length) {\n                      const data = payload[0].payload;\n                      return (\n                        <div className=\"bg-slate-900 text-white p-3 rounded-xl shadow-xl text-xs space-y-1.5 border border-slate-700\">\n                          <div className=\"font-bold flex items-center justify-between gap-3 text-slate-200\">\n                            <span>{data.date} ({data.dayOfWeek})</span>\n                            <span\n                              className={`px-1.5 py-0.5 rounded text-[10px] font-bold ${\n                                data.isOver\n                                  ? \'bg-rose-500/20 text-rose-300 border border-rose-500/30\'\n                                  : \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\'\n                              }`}\n                            >\n                              {data.isOver ? \'Exceeded Limit\' : \'Within Limit\'}\n                            </span>\n                          </div>\n                          <div className=\"pt-1 border-t border-slate-800 space-y-1\">\n                            <div className=\"flex justify-between gap-4\">\n                              <span className=\"text-slate-400\">Day\'s Spend:</span>\n                              <span className=\"font-semibold text-amber-300\">\n                                {formatCurrency(data.dailySpend, settings.currency)}\n                              </span>\n                            </div>\n                            <div className=\"flex justify-between gap-4\">\n                              <span className=\"text-slate-400\">Prorated Limit:</span>\n                              <span className=\"font-semibold text-slate-300\">\n                                {formatCurrency(data.dailyLimit, settings.currency)}\n                              </span>\n                            </div>\n                            <div className=\"flex justify-between gap-4\">\n                              <span className=\"text-slate-400\">Difference:</span>\n                              <span\n                                className={`font-semibold ${\n                                  data.delta > 0 ? \'text-rose-400\' : \'text-emerald-400\'\n                                }`}\n                              >\n                                {data.delta > 0 ? \'+\' : \'\'}\n                                {formatCurrency(data.delta, settings.currency)}\n                              </span>\n                            </div>\n                          </div>\n                        </div>\n                      );\n                    }\n                    return null;\n                  }}\n                />\n                {/* Reference ceiling line for daily limit */}\n                <ReferenceLine\n                  y={breakdown.dailyProratedLimit}\n                  stroke=\"#f59e0b\"\n                  strokeWidth={2}\n                  strokeDasharray=\"4 4\"\n                  label={{\n                    value: `Daily Limit: ${formatCurrency(breakdown.dailyProratedLimit, settings.currency)}`,\n                    position: \'insideTopRight\',\n                    fill: \'#d97706\',\n                    fontSize: 11,\n                    fontWeight: 600,\n                  }}\n                />\n                <Bar\n                  dataKey=\"dailySpend\"\n                  name=\"Daily Spend\"\n                  fill=\"#f59e0b\"\n                  radius={[4, 4, 0, 0]}\n                  // Color bars red if over limit!\n                  shape={(props: any) => {\n                    const { fill, x, y, width, height, payload } = props;\n                    const isOver = payload.isOver && payload.dailySpend > 0;\n                    return (\n                      <rect\n                        x={x}\n                        y={y}\n                        width={width}\n                        height={height}\n                        fill={isOver ? \'#ef4444\' : \'#f59e0b\'}\n                        rx={3}\n                        ry={3}\n                      />\n                    );\n                  }}\n                />\n              </ComposedChart>\n            ) : (\n              <LineChart data={chartData} margin={{ top: 10, right: 10, left: -10, bottom: 0 }}>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f1f5f9\" vertical={false} />\n                <XAxis\n                  dataKey=\"day\"\n                  tickLine={false}\n                  axisLine={{ stroke: \'#e2e8f0\' }}\n                  tick={{ fontSize: 11, fill: \'#64748b\' }}\n                  tickFormatter={(v) => `D${v}`}\n                />\n                <YAxis\n                  tickLine={false}\n                  axisLine={{ stroke: \'#e2e8f0\' }}\n                  tick={{ fontSize: 11, fill: \'#64748b\' }}\n                  tickFormatter={(v) => `${settings.currency}${v}`}\n                />\n                <Tooltip\n                  content={({ active, payload }) => {\n                    if (active && payload && payload.length) {\n                      const data = payload[0].payload;\n                      return (\n                        <div className=\"bg-slate-900 text-white p-3 rounded-xl shadow-xl text-xs space-y-1.5 border border-slate-700\">\n                          <div className=\"font-bold text-slate-200\">\n                            {data.date} (Day {data.day})\n                          </div>\n                          <div className=\"pt-1 border-t border-slate-800 space-y-1\">\n                            <div className=\"flex justify-between gap-4\">\n                              <span className=\"text-slate-400\">Cumulative Spent:</span>\n                              <span className=\"font-semibold text-indigo-300\">\n                                {formatCurrency(data.cumulativeSpend, settings.currency)}\n                              </span>\n                            </div>\n                            <div className=\"flex justify-between gap-4\">\n                              <span className=\"text-slate-400\">Cumulative Limit:</span>\n                              <span className=\"font-semibold text-slate-300\">\n                                {formatCurrency(data.cumulativeLimit, settings.currency)}\n                              </span>\n                            </div>\n                          </div>\n                        </div>\n                      );\n                    }\n                    return null;\n                  }}\n                />\n                <Line\n                  type=\"monotone\"\n                  dataKey=\"cumulativeLimit\"\n                  stroke=\"#94a3b8\"\n                  strokeWidth={2}\n                  strokeDasharray=\"4 4\"\n                  dot={false}\n                  name=\"Prorated Budget Ceiling\"\n                />\n                <Line\n                  type=\"monotone\"\n                  dataKey=\"cumulativeSpend\"\n                  stroke=\"#6366f1\"\n                  strokeWidth={2.5}\n                  dot={{ r: 3, fill: \'#6366f1\', strokeWidth: 1, stroke: \'#ffffff\' }}\n                  activeDot={{ r: 6 }}\n                  name=\"Actual Cumulative Spend\"\n                />\n              </LineChart>\n            )}\n          </ResponsiveContainer>\n        </div>\n\n        {/* Legend description */}\n        <div className=\"flex flex-wrap items-center justify-between text-xs text-slate-500 pt-4 border-t border-slate-100 mt-2 gap-2\">\n          <div className=\"flex items-center gap-4\">\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-3 h-3 rounded-sm bg-amber-500 inline-block\" />\n              Under / Within Daily Limit\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-3 h-3 rounded-sm bg-rose-500 inline-block\" />\n              Exceeded Daily Prorated Limit\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-3 h-0.5 bg-amber-500 inline-block border-t-2 border-dashed border-amber-500\" />\n              Daily Limit Line ({formatCurrency(breakdown.dailyProratedLimit, settings.currency)})\n            </span>\n          </div>\n          <span className=\"text-[11px] text-slate-400\">\n            Hover over any point to inspect day-by-day delta\n          </span>\n        </div>\n      </div>\n\n      {/* Day-by-Day Itemized Table & Calendar Breakdown */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n        <div className=\"p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900\">\n              Day-by-Day {activeRule.name} Spending Log\n            </h3>\n            <p className=\"text-xs text-slate-500\">\n              Detailed tracking for each day of {getMonthName(selectedMonth)}\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs text-slate-500\">Daily Target:</span>\n            <span className=\"px-2.5 py-1 rounded-lg bg-amber-100 text-amber-900 text-xs font-bold\">\n              {formatCurrency(breakdown.dailyProratedLimit, settings.currency)} / day\n            </span>\n          </div>\n        </div>\n\n        {/* Responsive Table */}\n        <div className=\"overflow-x-auto max-h-96\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 text-slate-600 font-semibold sticky top-0 border-b border-slate-200 z-10\">\n              <tr>\n                <th className=\"py-3 px-4\">Day</th>\n                <th className=\"py-3 px-4\">Date</th>\n                <th className=\"py-3 px-4\">Actual Spend</th>\n                <th className=\"py-3 px-4\">Prorated Limit</th>\n                <th className=\"py-3 px-4\">Status & Delta</th>\n                <th className=\"py-3 px-4\">Itemized Purchases</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {breakdown.dailyRecords.map((rec) => {\n                return (\n                  <tr\n                    key={rec.day}\n                    className={`hover:bg-slate-50/80 transition-colors ${\n                      rec.isOverLimit && rec.amountSpent > 0 ? \'bg-rose-50/30\' : \'\'\n                    }`}\n                  >\n                    <td className=\"py-3 px-4 font-bold text-slate-900\">\n                      Day {rec.day}\n                    </td>\n                    <td className=\"py-3 px-4 text-slate-500 whitespace-nowrap\">\n                      {rec.date} <span className=\"text-[10px] text-slate-400\">({rec.dayOfWeek})</span>\n                    </td>\n                    <td className=\"py-3 px-4 font-semibold whitespace-nowrap\">\n                      <span\n                        className={\n                          rec.amountSpent > 0\n                            ? rec.isOverLimit\n                              ? \'text-rose-600 font-bold text-sm\'\n                              : \'text-slate-900 font-bold text-sm\'\n                            : \'text-slate-400\'\n                        }\n                      >\n                        {formatCurrency(rec.amountSpent, settings.currency)}\n                      </span>\n                    </td>\n                    <td className=\"py-3 px-4 text-slate-500 whitespace-nowrap\">\n                      {formatCurrency(rec.dailyProratedLimit, settings.currency)}\n                    </td>\n                    <td className=\"py-3 px-4 whitespace-nowrap\">\n                      {rec.amountSpent === 0 ? (\n                        <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-500\">\n                          No Spend\n                        </span>\n                      ) : rec.isOverLimit ? (\n                        <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700 border border-rose-200\">\n                          <AlertCircle className=\"w-3 h-3\" />\n                          Exceeded +{formatCurrency(rec.delta, settings.currency)}\n                        </span>\n                      ) : (\n                        <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-100 text-emerald-700 border border-emerald-200\">\n                          <CheckCircle2 className=\"w-3 h-3\" />\n                          Saved {formatCurrency(Math.abs(rec.delta), settings.currency)}\n                        </span>\n                      )}\n                    </td>\n                    <td className=\"py-3 px-4\">\n                      {rec.transactions.length > 0 ? (\n                        <div className=\"space-y-1\">\n                          {rec.transactions.map((tx) => (\n                            <div\n                              key={tx.id}\n                              className=\"flex items-center justify-between gap-2 p-1.5 rounded-lg bg-slate-50 border border-slate-200/80\"\n                            >\n                              <div className=\"truncate\">\n                                <span className=\"font-semibold text-slate-800\">{tx.title}</span>\n                                {tx.tags && tx.tags.length > 0 && (\n                                  <span className=\"ml-1.5 text-[10px] text-indigo-600\">\n                                    {tx.tags.map((t) => `#${t}`).join(\' \')}\n                                  </span>\n                                )}\n                              </div>\n                              <div className=\"flex items-center gap-2 shrink-0\">\n                                <span className=\"font-bold text-slate-900\">\n                                  {formatCurrency(tx.amount, settings.currency)}\n                                </span>\n                                <button\n                                  type=\"button\"\n                                  onClick={() => deleteTransaction(tx.id)}\n                                  className=\"text-slate-400 hover:text-rose-600 p-0.5\"\n                                  title=\"Delete item\"\n                                >\n                                  <Trash2 className=\"w-3 h-3\" />\n                                </button>\n                              </div>\n                            </div>\n                          ))}\n                        </div>\n                      ) : (\n                        <span className=\"text-slate-400 italic text-[11px]\">No purchases</span>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState, useMemo } from \'react\';"
