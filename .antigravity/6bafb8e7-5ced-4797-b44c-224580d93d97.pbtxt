        }
        lines {
          text: "                  <div className=\"text-right shrink-0\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <span"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      className={`text-sm font-bold ${"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                        tx.type === \'income\' ? \'text-emerald-600\' : \'text-slate-900\'"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                      className={`text-sm font-mono font-bold ${"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        tx.type === \'income\' ? \'text-[#c1ff72]\' : \'text-zinc-100\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
