        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Table Specifications"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### A. `transactions`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Records all individual income and expense line items."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```sql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS transactions ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  title TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  amount REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  type TEXT NOT NULL,                -- \'income\' | \'expense\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  category TEXT NOT NULL,            -- category id or custom name"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  date TEXT NOT NULL,                -- \'YYYY-MM-DD\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  tags TEXT,                         -- JSON array of strings e.g. \'[\"snacks\", \"coffee\"]\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  notes TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  paymentMethod TEXT DEFAULT \'credit_card\', -- \'cash\' | \'credit_card\' | \'debit_card\' | \'bank_transfer\' | \'digital_wallet\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  isRecurring INTEGER DEFAULT 0,     -- boolean 0 or 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  recurringFrequency TEXT,           -- \'daily\' | \'weekly\' | \'monthly\' | \'yearly\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  receiptUrl TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  createdAt TEXT DEFAULT (datetime(\'now\'))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### B. `categories`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Stores default and user-created spending and income categories with monthly budget caps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```sql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS categories ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  icon TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  color TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  monthlyBudget REAL DEFAULT 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  isCustom INTEGER DEFAULT 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### C. `prorated_rules`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Defines dynamic daily pacing limits and tags/category mappings."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```sql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS prorated_rules ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  categoryId TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  targetTags TEXT,                   -- JSON array of strings"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  monthlyMaxSpend REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  month TEXT NOT NULL,               -- \'YYYY-MM\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  rolloverEnabled INTEGER DEFAULT 1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  rolloverAmount REAL DEFAULT 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  alertThresholdPercent REAL DEFAULT 100,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  notes TEXT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### D. `savings_goals` & `savings_history`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manages milestone savings targets and individual transaction logs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```sql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS savings_goals ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  targetAmount REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  currentAmount REAL DEFAULT 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  targetDate TEXT NOT NULL,           -- \'YYYY-MM-DD\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  icon TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  color TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  category TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  notes TEXT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS savings_history ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  goalId TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  date TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  amount REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  note TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  type TEXT DEFAULT \'deposit\',       -- \'deposit\' | \'withdraw\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  FOREIGN KEY (goalId) REFERENCES savings_goals(id) ON DELETE CASCADE"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### E. `debts` & `debt_payments`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manages liabilities, loans, and historical amortization payments."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```sql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS debts ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  totalPrincipal REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  remainingBalance REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  interestRate REAL DEFAULT 0,       -- Annual Percentage Rate (APR) e.g. 5.5"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  minimumPayment REAL DEFAULT 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  dueDay INTEGER DEFAULT 1,          -- 1 - 31"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  notes TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  color TEXT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS debt_payments ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  debtId TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  date TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  amount REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  principalPaid REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  interestPaid REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  note TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  FOREIGN KEY (debtId) REFERENCES debts(id) ON DELETE CASCADE"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### F. `recurring_items`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Tracks automated recurring bills and subscriptions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```sql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS recurring_items ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  title TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  amount REAL NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  type TEXT NOT NULL,                -- \'expense\' | \'income\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  category TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  frequency TEXT NOT NULL,           -- \'monthly\' | \'weekly\' | \'yearly\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  dayOfMonth INTEGER NOT NULL,       -- 1 - 31"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  autoApply INTEGER DEFAULT 1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  tags TEXT,                         -- JSON array"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  paymentMethod TEXT DEFAULT \'credit_card\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  lastAppliedMonth TEXT,             -- \'YYYY-MM\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  isActive INTEGER DEFAULT 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
