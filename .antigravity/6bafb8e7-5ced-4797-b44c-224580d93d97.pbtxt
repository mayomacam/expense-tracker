rt Parfait & Fruit Pack\',\n      amount: 9.25,\n      type: \'expense\',\n      category: \'cat-snacks\',\n      date: makeDate(8),\n      tags: [\'snacks\', \'healthy\'],\n      paymentMethod: \'digital_wallet\',\n    },\n    // Dining\n    {\n      id: \'tx-exp-dine-1\',\n      title: \'Ramen Izakaya Dinner with Friends\',\n      amount: 58.0,\n      type: \'expense\',\n      category: \'cat-dining\',\n      date: makeDate(4),\n      tags: [\'dining\', \'restaurant\', \'social\'],\n      paymentMethod: \'credit_card\',\n    },\n    {\n      id: \'tx-exp-dine-2\',\n      title: \'Fast-Casual Poke Bowl Lunch\',\n      amount: 22.4,\n      type: \'expense\',\n      category: \'cat-dining\',\n      date: makeDate(7),\n      tags: [\'dining\', \'takeout\'],\n      paymentMethod: \'digital_wallet\',\n    },\n    // Transport & Shopping\n    {\n      id: \'tx-exp-trans-1\',\n      title: \'Metro Monthly Transit Pass\',\n      amount: 90.0,\n      type: \'expense\',\n      category: \'cat-transport\',\n      date: makeDate(1),\n      tags: [\'transport\', \'commute\'],\n      paymentMethod: \'credit_card\',\n    },\n    {\n      id: \'tx-exp-shop-1\',\n      title: \'Ergonomic Desk Accessories\',\n      amount: 74.99,\n      type: \'expense\',\n      category: \'cat-shopping\',\n      date: makeDate(6),\n      tags: [\'shopping\', \'workstation\'],\n      paymentMethod: \'credit_card\',\n    },\n  ];\n\n  const initialSavingsGoals: SavingsGoal[] = [\n    {\n      id: \'goal-emergency-fund\',\n      name: \'6-Month Emergency Safety Fund\',\n      targetAmount: 15000,\n      currentAmount: 9800,\n      targetDate: `${year}-12-31`,\n      icon: \'ShieldCheck\',\n      color: \'#10B981\',\n      category: \'Security\',\n      notes: \'High-yield savings account liquid emergency buffer.\',\n      history: [\n        { id: \'h-1\', date: makeDate(1), amount: 500, type: \'deposit\', note: \'Monthly automatic allocation\' },\n        { id: \'h-0\', date: `${yearStr}-08-01`, amou