  file_change {
    absolute_path_uri: "file:///src/components/views/DashboardView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useMemo } from \'react\';\nimport {\n  ResponsiveContainer,\n  AreaChart,\n  Area,\n  PieChart,\n  Pie,\n  Cell,\n  XAxis,\n  YAxis,\n  Tooltip,\n  CartesianGrid,\n} from \'recharts\';\nimport {\n  TrendingUp,\n  TrendingDown,\n  Wallet,\n  AlertTriangle,\n  ArrowUpRight,\n  ArrowDownRight,\n  Plus,\n  Calendar,\n  Layers,\n  ChevronRight,\n  Cookie,\n  Target,\n  Sparkles,\n  Zap,\n} from \'lucide-react\';\nimport { useExpense } from \'../../context/ExpenseContext\';\nimport { formatCurrency, getMonthName, getDaysInMonth } from \'../../utils/formatters\';\nimport { CategoryIcon } from \'../common/CategoryIcon\';\nimport { calculateProratedDailyBreakdown } from \'../../utils/budgetCalculations\';\n\ninterface DashboardViewProps {\n  onOpenAddTransaction: () => void;\n  onNavigateTab: (tab: string) => void;\n  onOpenAddProrated: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  onOpenAddTransaction,\n  onNavigateTab,\n  onOpenAddProrated,\n}) => {\n  const {\n    transactions,\n    categories,\n    proratedRules,\n    savingsGoals,\n    debts,\n    alerts,\n    selectedMonth,\n    settings,\n  } = useExpense();\n\n  // Filter transactions for selected month\n  const monthTransactions = useMemo(() => {\n    return transactions.filter((t) => t.date.startsWith(selectedMonth));\n  }, [transactions, selectedMonth]);\n\n  // Financial summary\n  const summary = useMemo(() => {\n    let income = 0;\n    let expense = 0;\n\n    monthTransactions.forEach((t) => {\n      if (t.type === \'income\') income += t.amount;\n      else expense += t.amount;\n    });\n\n    const net = income - expense;\n    const savingsRate = income > 0 ? (net / income) * 100 : 0;\n\n    const totalBudget = categories.reduce((sum, c) => sum + (c.monthlyBudget || 0), 0);\n    const budgetUsedPercent = totalBudget > 0 ? (expense / totalBudget) * 100 : 0;\n\n    return {\n      income,\n      expense,\n      net,\n      savingsRate,\n      totalBudget,\n      budgetUsedPercent,\n    };\n  }, [monthTransactions, categories]);\n\n  // Category Breakdown for Pie Chart\n  const categoryChartData = useMemo(() => {\n    const map: Record<string, { name: string; value: number; color: string; icon: string }> = {};\n\n    categories.forEach((c) => {\n      map[c.id] = { name: c.name, value: 0, color: c.color, icon: c.icon };\n    });\n\n    monthTransactions\n      .filter((t) => t.type === \'expense\')\n      .forEach((t) => {\n        if (!map[t.category]) {\n          map[t.category] = { name: \'Other\', value: 0, color: \'#94a3b8\', icon: \'Tag\' };\n        }\n        map[t.category].value += t.amount;\n      });\n\n    return Object.values(map)\n      .filter((c) => c.value > 0)\n      .sort((a, b) => b.value - a.value);\n  }, [categories, monthTransactions]);\n\n  // Daily Spending Trend for Area Chart\n  const dailySpendData = useMemo(() => {\n    const daysInMon = getDaysInMonth(selectedMonth);\n    const dayMap: Record<number, number> = {};\n    for (let d = 1; d <= daysInMon; d++) dayMap[d] = 0;\n\n    monthTransactions\n      .filter((t) => t.type === \'expense\')\n      .forEach((t) => {\n        const day = parseInt(t.date.split(\'-\')[2], 10);\n        if (day >= 1 && day <= daysInMon) {\n          dayMap[day] = (dayMap[day] || 0) + t.amount;\n        }\n      });\n\n    return Object.entries(dayMap).map(([day, amount]) => ({\n      day: parseInt(day, 10),\n      dayLabel: `Day ${day}`,\n      amount: Number(amount.toFixed(2)),\n    }));\n  }, [selectedMonth, monthTransactions]);\n\n  // Primary Prorated Rule Spotlight (e.g. Snacks)\n  const primaryProratedRule = proratedRules[0] || null;\n  const proratedBreakdown = useMemo(() => {\n    if (!primaryProratedRule) return null;\n    return calculateProratedDailyBreakdown(primaryProratedRule, transactions, selectedMonth);\n  }, [primaryProratedRule, transactions, selectedMonth]);\n\n  // Unread high-priority alerts\n  const criticalAlerts = useMemo(() => {\n    return alerts.filter((a) => !a.read && (a.severity === \'danger\' || a.severity === \'warning\'));\n  }, [alerts]);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Alert Banner if any critical issues */}\n      {criticalAlerts.length > 0 && (\n        <div className=\"bg-gradient-to-r from-rose-500/10 via-amber-500/10 to-transparent border border-rose-200 p-4 rounded-2xl flex items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center shrink-0 shadow-xs\">\n              <AlertTriangle className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h4 className=\"text-xs font-bold text-rose-900\">\n                {criticalAlerts[0].title}\n              </h4>\n              <p className=\"text-xs text-slate-600 mt-0.5 max-w-xl\">\n                {criticalAlerts[0].message}\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => onNavigateTab(criticalAlerts[0].linkTab || \'prorated\')}\n            className=\"px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 rounded-xl text-xs font-semibold shrink-0 transition-colors shadow-2xs\"\n          >\n            Review Details \342\206\222\n          </button>\n        </div>\n      )}\n\n      {/* Primary KPI Cards */}\n      <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Total Income */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Total Income</span>\n            <div className=\"w-6 h-6 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n              <ArrowDownRight className=\"w-3.5 h-3.5\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-bold text-emerald-600\">\n            {formatCurrency(summary.income, settings.currency)}\n          </div>\n          <div className=\"text-[11px] text-slate-400 mt-1\">\n            For {getMonthName(selectedMonth)}\n          </div>\n        </div>\n\n        {/* Total Expenses */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Total Expenses</span>\n            <div className=\"w-6 h-6 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center\">\n              <ArrowUpRight className=\"w-3.5 h-3.5\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-bold text-slate-900\">\n            {formatCurrency(summary.expense, settings.currency)}\n          </div>\n          <div className=\"text-[11px] text-slate-500 mt-1\">\n            {summary.totalBudget > 0 ? (\n              <span>\n                {summary.budgetUsedPercent.toFixed(0)}% of {formatCurrency(summary.totalBudget, settings.currency)} budget\n              </span>\n            ) : (\n              <span>All recorded spending</span>\n            )}\n          </div>\n        </div>\n\n        {/* Net Savings & Rate */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden\">\n          <div className=\"flex items-center justify-between text-xs font-semibold text-slate-500 mb-1\">\n            <span>Net Savings</span>\n            <div className=\"w-6 h-6 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center\">\n              <Wallet className=\"w-3.5 h-3.5\" />\n            </div>\n          </div>\n          <div\n            className={`text-2xl font-bold ${\n              summary.net >= 0 ? \'text-indigo-600\' : \'text-rose-600\'\n            }`}\n          >\n            {formatCurrency(summary.net, settings.currency)}\n          </div>\n          <div className=\"text-[11px] text-slate-500 mt-1 flex items-center justify-between\">\n            <span>Savings Rate:</span>\n            <span className=\"font-bold text-indigo-700\">\n              {summary.savingsRate > 0 ? `+${summary.savingsRate.toFixed(1)}%` : \'0%\'}\n            </span>\n          </div>\n        </div>\n\n        {/* Prorated Daily Limit Spotlight */}\n        <div\n          onClick={() => onNavigateTab(\'prorated\')}\n          className=\"bg-gradient-to-br from-amber-50 to-orange-50/60 p-5 rounded-2xl border border-amber-200/80 shadow-xs cursor-pointer hover:shadow-md transition-all group\"\n        >\n          <div className=\"flex items-center justify-between text-xs font-semibold text-amber-800 mb-1\">\n            <span className=\"truncate\">\n              {primaryProratedRule ? `${primaryProratedRule.name} Daily Cap` : \'Prorated Limit\'}\n            </span>\n            <div className=\"w-6 h-6 rounded-lg bg-amber-500 text-white flex items-center justify-center\">\n              <Cookie className=\"w-3.5 h-3.5\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-bold text-amber-900\">\n            {proratedBreakdown\n              ? formatCurrency(proratedBreakdown.dailyProratedLimit, settings.currency)\n              : formatCurrency(0, settings.currency)}\n            <span className=\"text-xs text-amber-700 font-normal ml-1\">/ day</span>\n          </div>\n          <div className=\"text-[11px] text-amber-800 mt-1 flex items-center justify-between\">\n            <span>\n              {proratedBreakdown\n                ? `${formatCurrency(proratedBreakdown.totalSpentSoFar, settings.currency)} spent`\n                : \'Click to setup\'}\n            </span>\n            <span className=\"text-amber-700 font-bold group-hover:translate-x-0.5 transition-transform\">\n              View Tracker \342\206\222\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Charts Row */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Daily Spending Trend Line/Area Chart */}\n        <div className=\"lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-200 shadow-xs\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900\">Daily Spending Flow</h3>\n              <p className=\"text-xs text-slate-500\">Expenses logged day-by-day throughout the month</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => onNavigateTab(\'reports\')}\n              className=\"text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors\"\n            >\n              Full Reports \342\206\222\n            </button>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={dailySpendData} margin={{ top: 10, right: 10, left: -10, bottom: 0 }}>\n                <defs>\n                  <linearGradient id=\"spendGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#6366f1\" stopOpacity={0.3} />\n                    <stop offset=\"95%\" stopColor=\"#6366f1\" stopOpacity={0} />\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f1f5f9\" vertical={false} />\n                <XAxis\n                  dataKey=\"day\"\n                  tickLine={false}\n                  axisLine={{ stroke: \'#e2e8f0\' }}\n                  tick={{ fontSize: 11, fill: \'#64748b\' }}\n                  tickFormatter={(v) => `D${v}`}\n                />\n                <YAxis\n                  tickLine={false}\n                  axisLine={{ stroke: \'#e2e8f0\' }}\n                  tick={{ fontSize: 11, fill: \'#64748b\' }}\n                  tickFormatter={(v) => `${settings.currency}${v}`}\n                />\n                <Tooltip\n                  content={({ active, payload }) => {\n                    if (active && payload && payload.length) {\n                      return (\n                        <div className=\"bg-slate-900 text-white p-2.5 rounded-xl shadow-lg text-xs\">\n                          <div className=\"font-semibold text-slate-300\">\n                            Day {payload[0].payload.day}\n                          </div>\n                          <div className=\"text-indigo-300 font-bold mt-0.5\">\n                            {formatCurrency(payload[0].value as number, settings.currency)}\n                          </div>\n                        </div>\n                      );\n                    }\n                    return null;\n                  }}\n                />\n                <Area\n                  type=\"monotone\"\n                  dataKey=\"amount\"\n                  stroke=\"#6366f1\"\n                  strokeWidth={2}\n                  fillOpacity={1}\n                  fill=\"url(#spendGrad)\"\n                />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Category Breakdown Donut */}\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between mb-2\">\n              <h3 className=\"text-base font-bold text-slate-900\">Spending by Category</h3>\n              <span className=\"text-xs text-slate-400\">{categoryChartData.length} active</span>\n            </div>\n            <p className=\"text-xs text-slate-500 mb-4\">Distribution of total monthly spend</p>\n          </div>\n\n          <div className=\"h-44 w-full relative\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={categoryChartData}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={45}\n                  outerRadius={65}\n                  paddingAngle={3}\n                  dataKey=\"value\"\n                >\n                  {categoryChartData.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} />\n                  ))}\n                </Pie>\n                <Tooltip\n                  formatter={(val: number) => [formatCurrency(val, settings.currency), \'Spent\']}\n                />\n              </PieChart>\n            </ResponsiveContainer>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none\">\n              <span className=\"text-[10px] uppercase font-bold text-slate-400\">Total Spent</span>\n              <span className=\"text-xs font-bold text-slate-800\">\n                {formatCurrency(summary.expense, settings.currency)}\n              </span>\n            </div>\n          </div>\n\n          {/* Legend */}\n          <div className=\"space-y-1.5 max-h-32 overflow-y-auto mt-2 pt-2 border-t border-slate-100\">\n            {categoryChartData.slice(0, 5).map((cat) => {\n              const pct = summary.expense > 0 ? ((cat.value / summary.expense) * 100).toFixed(0) : \'0\';\n              return (\n                <div key={cat.name} className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-2 truncate\">\n                    <span\n                      className=\"w-2.5 h-2.5 rounded-full shrink-0\"\n                      style={{ backgroundColor: cat.color }}\n                    />\n                    <span className=\"text-slate-700 truncate\">{cat.name}</span>\n                  </div>\n                  <div className=\"flex items-center gap-2 shrink-0 font-medium text-slate-900\">\n                    <span>{formatCurrency(cat.value, settings.currency)}</span>\n                    <span className=\"text-slate-400 text-[10px] w-7 text-right\">{pct}%</span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Section: Prorated Snapshot & Recent Transactions */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Prorated Spending Spotlight Card */}\n        {proratedBreakdown && primaryProratedRule && (\n          <div className=\"bg-gradient-to-br from-amber-500/10 via-orange-500/5 to-white p-6 rounded-2xl border border-amber-200/80 shadow-xs flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-100/80 px-2 py-0.5 rounded-full border border-amber-200\">\n                  Featured Daily Limit\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigateTab(\'prorated\')}\n                  className=\"text-xs font-semibold text-amber-800 hover:text-amber-900\"\n                >\n                  Open Analyzer \342\206\222\n                </button>\n              </div>\n              <h4 className=\"text-base font-bold text-slate-900 mt-2\">\n                {primaryProratedRule.name} Spending Tracker\n              </h4>\n              <p className=\"text-xs text-slate-600 mt-0.5\">\n                Cap: {formatCurrency(primaryProratedRule.monthlyMaxSpend, settings.currency)} / month\n              </p>\n\n              {/* Progress bar */}\n              <div className=\"mt-4\">\n                <div className=\"flex justify-between text-xs font-semibold text-slate-700 mb-1\">\n                  <span>Month-to-date Used</span>\n                  <span>\n                    {((proratedBreakdown.totalSpentSoFar / proratedBreakdown.effectiveMonthlyBudget) * 100).toFixed(0)}%\n                  </span>\n                </div>\n                <div className=\"w-full bg-slate-200 rounded-full h-2.5 overflow-hidden\">\n                  <div\n                    className={`h-full rounded-full transition-all ${\n                      proratedBreakdown.totalSpentSoFar > proratedBreakdown.effectiveMonthlyBudget\n                        ? \'bg-rose-500\'\n                        : \'bg-amber-500\'\n                    }`}\n                    style={{\n                      width: `${Math.min(\n                        100,\n                        (proratedBreakdown.totalSpentSoFar / proratedBreakdown.effectiveMonthlyBudget) * 100\n                      )}%`,\n                    }}\n                  />\n                </div>\n              </div>\n\n              {/* Stats row */}\n              <div className=\"grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-amber-200/60 text-xs\">\n                <div>\n                  <span className=\"text-slate-500 text-[11px] block\">Daily Prorated Target:</span>\n                  <span className=\"font-bold text-amber-900\">\n                    {formatCurrency(proratedBreakdown.dailyProratedLimit, settings.currency)} / day\n                  </span>\n                </div>\n                <div>\n                  <span className=\"text-slate-500 text-[11px] block\">Over-Limit Days:</span>\n                  <span\n                    className={`font-bold ${\n                      proratedBreakdown.exceededDaysCount > 0 ? \'text-rose-600\' : \'text-emerald-600\'\n                    }`}\n                  >\n                    {proratedBreakdown.exceededDaysCount} days flagged\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => onNavigateTab(\'prorated\')}\n              className=\"mt-4 w-full py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-semibold transition-colors flex items-center justify-center gap-1.5 shadow-xs\"\n            >\n              <Zap className=\"w-3.5 h-3.5\" />\n              View Daily Graphs & Day Log\n            </button>\n          </div>\n        )}\n\n        {/* Recent Transactions List */}\n        <div className={`bg-white p-6 rounded-2xl border border-slate-200 shadow-xs ${proratedBreakdown ? \'lg:col-span-2\' : \'lg:col-span-3\'}`}>\n          <div className=\"flex items-center justify-between mb-4\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900\">Recent Transactions</h3>\n              <p className=\"text-xs text-slate-500\">Latest expenses & income logged</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => onNavigateTab(\'transactions\')}\n              className=\"text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors\"\n            >\n              View All ({transactions.length}) \342\206\222\n            </button>\n          </div>\n\n          <div className=\"space-y-2.5\">\n            {monthTransactions.slice(0, 5).map((tx) => {\n              const cat = categories.find((c) => c.id === tx.category);\n              return (\n                <div\n                  key={tx.id}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl bg-slate-50/70 hover:bg-slate-50 border border-slate-100 transition-colors\"\n                >\n                  <div className=\"flex items-center gap-3 truncate\">\n                    <div\n                      className=\"w-9 h-9 rounded-xl flex items-center justify-center text-white shrink-0 shadow-2xs\"\n                      style={{ backgroundColor: cat?.color || \'#6366F1\' }}\n                    >\n                      <CategoryIcon name={cat?.icon || \'Tag\'} className=\"w-4 h-4\" />\n                    </div>\n                    <div className=\"truncate\">\n                      <h4 className=\"text-xs font-bold text-slate-900 truncate\">{tx.title}</h4>\n                      <div className=\"flex items-center gap-2 text-[11px] text-slate-500\">\n                        <span>{tx.date}</span>\n                        <span>\342\200\242</span>\n                        <span>{cat?.name || \'General\'}</span>\n                        {tx.tags && tx.tags.length > 0 && (\n                          <>\n                            <span>\342\200\242</span>\n                            <span className=\"text-indigo-600\">#{tx.tags[0]}</span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"text-right shrink-0\">\n                    <span\n                      className={`text-sm font-bold ${\n                        tx.type === \'income\' ? \'text-emerald-600\' : \'text-slate-900\'\n                      }`}\n                    >\n                      {tx.type === \'income\' ? \'+\' : \'-\'}\n                      {formatCurrency(tx.amount, settings.currency)}\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
