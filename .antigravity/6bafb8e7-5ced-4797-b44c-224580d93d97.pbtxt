          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        merged.paymentMethod,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        merged.isRecurring ? 1 : 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
