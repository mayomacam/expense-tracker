          text: "    run("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      `INSERT INTO transactions (id, title, amount, type, category, date, tags, notes, paymentMethod, isRecurring, recurringFrequency, receiptUrl)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
