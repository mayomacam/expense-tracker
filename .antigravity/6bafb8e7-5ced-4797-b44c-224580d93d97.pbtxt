  file_change {
    absolute_path_uri: "file:///src/components/views/CategorySettingsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Settings,\n  Plus,\n  Trash2,\n  Edit2,\n  Bell,\n  RefreshCw,\n  Sliders,\n  DollarSign,\n  Palette,\n  ShieldAlert,\n  CheckCircle2,\n} from \'lucide-react\';\nimport { useExpense } from \'../../context/ExpenseContext\';\nimport { Category } from \'../../types\';\nimport { CategoryIcon, AVAILABLE_ICONS } from \'../common/CategoryIcon\';\nimport { formatCurrency } from \'../../utils/formatters\';\n\ninterface CategorySettingsViewProps {\n  onOpenAddCategory: () => void;\n  onEditCategory: (cat: Category) => void;\n}\n\nexport const CategorySettingsView: React.FC<CategorySettingsViewProps> = ({\n  onOpenAddCategory,\n  onEditCategory,\n}) => {\n  const {\n    categories,\n    deleteCategory,\n    settings,\n    updateSettings,\n    resetToSeedData,\n  } = useExpense();\n\n  const [testNotificationSent, setTestNotificationSent] = useState(false);\n  const [showResetConfirm, setShowResetConfirm] = useState(false);\n\n  const handleTestPushNotification = async () => {\n    if (\'Notification\' in window) {\n      if (Notification.permission === \'granted\') {\n        new Notification(\'SpendWise Budget Alert\', {\n          body: \'Automated notification test: Your daily snack spending is on track today!\',\n          icon: \'/favicon.ico\',\n        });\n        setTestNotificationSent(true);\n        setTimeout(() => setTestNotificationSent(false), 3000);\n      } else if (Notification.permission !== \'denied\') {\n        const perm = await Notification.requestPermission();\n        if (perm === \'granted\') {\n          new Notification(\'SpendWise Budget Alert\', {\n            body: \'Push notifications successfully activated!\',\n          });\n          setTestNotificationSent(true);\n          setTimeout(() => setTestNotificationSent(false), 3000);\n        }\n      }\n    } else {\n      alert(\'Your browser does not support HTML5 desktop notifications.\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900\">\n            Categories & Application Settings\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Configure custom category icons, budget caps, automated push notifications, and currencies\n          </p>\n        </div>\n\n        <button\n          type=\"button\"\n          id=\"add-new-category-btn\"\n          onClick={onOpenAddCategory}\n          className=\"px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-xs flex items-center gap-1.5 transition-colors self-start sm:self-auto shrink-0\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Custom Category</span>\n        </button>\n      </div>\n\n      {/* Preferences & Notifications Config */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        {/* Currency & Thresholds */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4\">\n          <div className=\"flex items-center gap-2 text-slate-900 font-bold text-sm\">\n            <DollarSign className=\"w-4 h-4 text-indigo-600\" />\n            <span>Currency & Regional Settings</span>\n          </div>\n\n          <div className=\"space-y-3 text-xs\">\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">\n                Display Currency Symbol\n              </label>\n              <select\n                value={settings.currency}\n                onChange={(e) => updateSettings({ currency: e.target.value })}\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium\"\n              >\n                <option value=\"$\">USD ($) - US Dollar</option>\n                <option value=\"\342\202\254\">EUR (\342\202\254) - Euro</option>\n                <option value=\"\302\243\">GBP (\302\243) - British Pound</option>\n                <option value=\"\302\245\">JPY (\302\245) - Japanese Yen</option>\n                <option value=\"\342\202\271\">INR (\342\202\271) - Indian Rupee</option>\n                <option value=\"C$\">CAD (C$) - Canadian Dollar</option>\n                <option value=\"A$\">AUD (A$) - Australian Dollar</option>\n              </select>\n            </div>\n\n            <div className=\"pt-2\">\n              <label className=\"flex items-center justify-between font-semibold text-slate-700 cursor-pointer\">\n                <span>Enable Budget Rollover by Default</span>\n                <input\n                  type=\"checkbox\"\n                  checked={settings.enableRolloverByDefault}\n                  onChange={(e) => updateSettings({ enableRolloverByDefault: e.target.checked })}\n                  className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4\"\n                />\n              </label>\n              <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                Automatically carries unspent budget surplus to the following month.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Automated Push Notifications */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4\">\n          <div className=\"flex items-center gap-2 text-slate-900 font-bold text-sm\">\n            <Bell className=\"w-4 h-4 text-amber-500\" />\n            <span>Automated Push Notifications</span>\n          </div>\n\n          <div className=\"space-y-3 text-xs\">\n            <label className=\"flex items-center justify-between font-semibold text-slate-700 cursor-pointer\">\n              <span>Enable In-App & Browser Alerts</span>\n              <input\n                type=\"checkbox\"\n                checked={settings.enablePushNotifications}\n                onChange={(e) => updateSettings({ enablePushNotifications: e.target.checked })}\n                className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4\"\n              />\n            </label>\n            <p className=\"text-[11px] text-slate-400\">\n              Receive instant alerts whenever a daily prorated spending limit is breached or a monthly category budget nears cap.\n            </p>\n\n            <button\n              type=\"button\"\n              onClick={handleTestPushNotification}\n              className=\"px-3.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-colors\"\n            >\n              <Bell className=\"w-3.5 h-3.5\" />\n              <span>Send Test Notification</span>\n            </button>\n\n            {testNotificationSent && (\n              <span className=\"text-[11px] text-emerald-600 font-semibold flex items-center gap-1\">\n                <CheckCircle2 className=\"w-3.5 h-3.5\" /> Notification dispatched!\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Category Management List */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n        <div className=\"p-5 border-b border-slate-100 flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900\">Custom Category Palette</h3>\n            <p className=\"text-xs text-slate-500\">\n              Manage custom icons, accent colors, and monthly default budgets\n            </p>\n          </div>\n          <span className=\"text-xs font-semibold text-slate-500\">\n            {categories.length} categories active\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-5\">\n          {categories.map((cat) => (\n            <div\n              key={cat.id}\n              className=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors flex items-center justify-between gap-3\"\n            >\n              <div className=\"flex items-center gap-3 truncate\">\n                <div\n                  className=\"w-10 h-10 rounded-xl flex items-center justify-center text-white shrink-0 shadow-2xs\"\n                  style={{ backgroundColor: cat.color }}\n                >\n                  <CategoryIcon name={cat.icon} className=\"w-5 h-5\" />\n                </div>\n                <div className=\"truncate\">\n                  <h4 className=\"text-xs font-bold text-slate-900 truncate\">{cat.name}</h4>\n                  <span className=\"text-[11px] text-slate-500\">\n                    Budget: {cat.monthlyBudget ? formatCurrency(cat.monthlyBudget, settings.currency) : \'None\'}\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-1 shrink-0\">\n                <button\n                  type=\"button\"\n                  onClick={() => onEditCategory(cat)}\n                  className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-200 rounded-lg transition-colors\"\n                  title=\"Edit Category\"\n                >\n                  <Edit2 className=\"w-3.5 h-3.5\" />\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => deleteCategory(cat.id)}\n                  className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors\"\n                  title=\"Delete Category\"\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Danger Zone: Reset to Default Data */}\n      <div className=\"p-5 rounded-2xl border border-rose-200 bg-rose-50/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h4 className=\"text-xs font-bold text-rose-900 flex items-center gap-1.5\">\n            <ShieldAlert className=\"w-4 h-4 text-rose-600\" />\n            Reset Initial Sample Data\n          </h4>\n          <p className=\"text-xs text-rose-700/80 mt-0.5 max-w-xl\">\n            Restore sample data including the $500 Snacks prorated daily tracker, sample transactions, savings goals, and debts.\n          </p>\n        </div>\n\n        {showResetConfirm ? (\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                resetToSeedData();\n                setShowResetConfirm(false);\n              }}\n              className=\"px-3 py-1.5 bg-rose-600 text-white text-xs font-bold rounded-lg hover:bg-rose-700\"\n            >\n              Confirm Reset\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setShowResetConfirm(false)}\n              className=\"px-3 py-1.5 bg-white text-slate-600 text-xs font-medium rounded-lg hover:bg-slate-100\"\n            >\n              Cancel\n            </button>\n          </div>\n        ) : (\n          <button\n            type=\"button\"\n            onClick={() => setShowResetConfirm(true)}\n            className=\"px-3.5 py-1.5 bg-white text-rose-700 border border-rose-200 rounded-xl text-xs font-semibold hover:bg-rose-50 transition-colors shadow-2xs self-start sm:self-auto\"\n          >\n            Reset to Sample Data\n          </button>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
