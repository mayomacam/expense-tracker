    instruction: "Update reset section with Reset to Zero and Load Demo buttons"
    replacement_infos {
      original_chunk {
        target_content: "            {/* Reset Database Section */}\n            <div className=\"pt-2 border-t border-white/[0.06]\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h4 className=\"text-xs font-bold text-white flex items-center gap-1.5\">\n                    <AlertTriangle className=\"w-3.5 h-3.5 text-amber-400\" />\n                    Reset SQLite Database\n                  </h4>\n                  <p className=\"text-[11px] text-zinc-400\">\n                    Re-seed database tables with standard sample figures\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  id=\"reset-sqlite-db-btn\"\n                  onClick={handleResetDb}\n                  disabled={isResetting}\n                  className=\"px-3 py-1.5 text-xs font-bold text-[#ff5f5f] hover:text-white hover:bg-[#ff5f5f]/20 border border-[#ff5f5f]/30 rounded-xl transition-all flex items-center gap-1.5 uppercase\"\n                >\n                  <RotateCcw className={`w-3.5 h-3.5 ${isResetting ? \'animate-spin\' : \'\'}`} />\n                  {isResetting ? \'Resetting...\' : \'Re-seed DB\'}\n                </button>\n              </div>\n\n              {resetSuccess && (\n                <div className=\"mt-2 text-[11px] text-[#c1ff72] flex items-center gap-1 font-bold\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                  SQLite database successfully re-seeded!\n                </div>\n              )}\n            </div>"
        replacement_content: "            {/* Reset Database Section */}\n            <div className=\"pt-3 border-t border-white/[0.06] space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h4 className=\"text-xs font-bold text-white flex items-center gap-1.5\">\n                    <AlertTriangle className=\"w-3.5 h-3.5 text-amber-400\" />\n                    Reset All Data to Zero (Clean Slate)\n                  </h4>\n                  <p className=\"text-[11px] text-zinc-400\">\n                    Wipe all fake transactions, goals, debts & start fresh with \342\202\2710 balances\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  id=\"reset-to-zero-db-btn\"\n                  onClick={handleResetToZero}\n                  disabled={isResetting}\n                  className=\"px-3 py-1.5 text-xs font-bold text-[#ff5f5f] hover:text-white hover:bg-[#ff5f5f]/20 border border-[#ff5f5f]/30 rounded-xl transition-all flex items-center gap-1.5 uppercase tracking-wider\"\n                >\n                  <RotateCcw className={`w-3.5 h-3.5 ${isResetting ? \'animate-spin\' : \'\'}`} />\n                  {isResetting ? \'Resetting...\' : \'Reset to Zero\'}\n                </button>\n              </div>\n\n              <div className=\"flex items-center justify-between pt-2 border-t border-white/[0.04]\">\n                <div>\n                  <h5 className=\"text-[11px] font-bold text-zinc-300\">\n                    Demo Sample Data (Optional)\n                  </h5>\n                  <p className=\"text-[10px] text-zinc-500\">\n                    Populate sample transactions for testing charts & features\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  id=\"load-demo-db-btn\"\n                  onClick={handleLoadDemo}\n                  disabled={isResetting}\n                  className=\"px-3 py-1 text-[11px] font-bold text-zinc-300 hover:text-white hover:bg-white/10 border border-white/10 rounded-xl transition-all uppercase tracking-wider\"\n                >\n                  Load Demo Data\n                </button>\n              </div>\n\n              {resetSuccess && (\n                <div className=\"mt-2 p-2 rounded-lg bg-[#c1ff72]/10 border border-[#c1ff72]/30 text-[11px] text-[#c1ff72] flex items-center gap-1.5 font-bold\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                  {resetSuccess}\n                </div>\n              )}\n            </div>"
      }
      num_matches: 1
    }
  }
}
