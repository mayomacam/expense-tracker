    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 10 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: 10 }}\n          className=\"w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden\"\n        >\n          {/* Header */}\n          <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/70\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shadow-xs\">\n                <FileSpreadsheet className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h3 className=\"text-base font-semibold text-slate-800\">Export CSV Data & Reports</h3>\n                <p className=\"text-xs text-slate-500\">Download formatted financial spreadsheets</p>\n              </div>\n            </div>\n            <button\n              id=\"close-export-btn\"\n              onClick={onClose}\n              className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 rounded-full transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          <div className=\"p-6 space-y-4\">\n            <div className=\"space-y-2\">\n              <label className=\"block text-xs font-semibold text-slate-700\">\n                Select Report Format\n              </label>\n\n              {/* Options */}\n              <div\n                onClick={() => setExportType(\'monthly_statement\')}\n                className={`p-3.5 rounded-xl border cursor-pointer transition-all flex items-start gap-3 ${\n                  exportType === \'monthly_statement\'\n                    ? \'border-emerald-500 bg-emerald-50/40 ring-1 ring-emerald-500/20\'\n                    : \'border-slate-200 hover:bg-slate-50\'\n                }`}\n              >\n                <div className=\"mt-0.5 p-1 rounded-md bg-emerald-100 text-emerald-700\">\n                  <FileText className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs font-bold text-slate-800\">\n                      Monthly Comprehensive Statement\n                    </span>\n                    <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-semibold\">\n                      Recommended\n                    </span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Includes {getMonthName(selectedMonth)} income, expenses, category spending vs budget,\n                    prorated snack limits, and itemized records.\n                  </p>\n                </div>\n              </div>\n\n              <div\n                onClick={() => setExportType(\'transactions_all\')}\n                className={`p-3.5 rounded-xl border cursor-pointer transition-all flex items-start gap-3 ${\n                  exportType === \'transactions_all\'\n                    ? \'border-emerald-500 bg-emerald-50/40 ring-1 ring-emerald-500/20\'\n                    : \'border-slate-200 hover:bg-slate-50\'\n                }`}\n              >\n                <div className=\"mt-0.5 p-1 rounded-md bg-indigo-100 text-indigo-700\">\n                  <FileSpreadsheet className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <span className=\"text-xs font-bold text-slate-800 block\">\n                    All Historical Transactions (Raw CSV)\n                  </span>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Complete itemized list ({transactions.length} transactions) with tags, payment methods, and notes.\n                  </p>\n                </div>\n              </div>\n\n              <div\n                onClick={() => setExportType(\'prorated_log\')}\n                className={`p-3.5 rounded-xl border cursor-pointer transition-all flex items-start gap-3 ${\n                  exportType === \'prorated_log\'\n                    ? \'border-emerald-500 bg-emerald-50/40 ring-1 ring-emerald-500/20\'\n                    : \'border-slate-200 hover:bg-slate-50\'\n                }`}\n              >\n                <div className=\"mt-0.5 p-1 rounded-md bg-amber-100 text-amber-700\">\n                  <Calendar className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <span className=\"text-xs font-bold text-slate-800 block\">\n                    Prorated Daily Spending Rules & Rollover\n                  </span>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Summary of all prorated daily rules, rollover balances, and daily thresholds.\n                  </p>\n                </div>\n              </div>\n\n              <div\n                onClick={() => setExportType(\'savings_debt\')}\n                className={`p-3.5 rounded-xl border cursor-pointer transition-all flex items-start gap-3 ${\n                  exportType === \'savings_debt\'\n                    ? \'border-emerald-500 bg-emerald-50/40 ring-1 ring-emerald-500/20\'\n                    : \'border-slate-200 hover:bg-slate-50\'\n                }`}\n              >\n                <div className=\"mt-0.5 p-1 rounded-md bg-rose-100 text-rose-700\">\n                  <FileSpreadsheet className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <span className=\"text-xs font-bold text-slate-800 block\">\n                    Savings Goals & Debt Repayment Portfolio\n                  </span>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Portfolio progress status for all active savings targets and loans.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center justify-end gap-2 pt-3 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                id=\"cancel-export-modal-btn\"\n                onClick={onClose}\n                className=\"px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800 rounded-xl hover:bg-slate-100 transition-colors\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"button\"\n                id=\"confirm-export-csv-btn\"\n                onClick={handleExport}\n                className=\"px-5 py-2.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-colors flex items-center gap-2\"\n              >\n                {downloadSuccess ? (\n                  <>\n                    <CheckCircle2 className=\"w-4 h-4\" />\n                    Downloaded!\n                  </>\n                ) : (\n                  <>\n                    <Download className=\"w-4 h-4\" />\n                    Export CSV Report\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );"
