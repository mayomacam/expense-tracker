        }
        lines {
          text: "export function getDaysInMonth(yearMonth: string): number {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [year, month] = yearMonth.split(\'-\').map(Number);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // month is 1-indexed in \"YYYY-MM\", passing month directly to Date(year, month, 0) gives last day of that month"
