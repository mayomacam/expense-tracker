    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport * as Icons from \'lucide-react\';\nimport { LucideProps } from \'lucide-react\';\n\ninterface CategoryIconProps extends LucideProps {\n  name: string;\n  className?: string;\n  fallback?: string;\n}\n\nexport const CategoryIcon: React.FC<CategoryIconProps> = ({\n  name,\n  className = \'w-5 h-5\',\n  fallback = \'CircleDollarSign\',\n  ...props\n}) => {\n  // Try to find the icon by exact name or capitalized name\n  const iconKey = (name in Icons\n    ? name\n    : Object.keys(Icons).find((k) => k.toLowerCase() === name.toLowerCase()) ||\n      fallback) as keyof typeof Icons;\n\n  const IconComponent = (Icons[iconKey] as React.ComponentType<LucideProps>) || Icons.CircleDollarSign;\n\n  return <IconComponent className={className} {...props} />;\n};\n\nexport const AVAILABLE_ICONS = [\n  \'Cookie\',\n  \'Utensils\',\n  \'ShoppingBag\',\n  \'Coffee\',\n  \'Home\',\n  \'Zap\',\n  \'Car\',\n  \'Tv\',\n  \'Tag\',\n  \'HeartPulse\',\n  \'Banknote\',\n  \'Laptop\',\n  \'TrendingUp\',\n  \'ShieldCheck\',\n  \'Plane\',\n  \'Gift\',\n  \'GraduationCap\',\n  \'Smartphone\',\n  \'Film\',\n  \'Fuel\',\n  \'Music\',\n  \'Wifi\',\n  \'Dumbbell\',\n  \'Smile\',\n  \'Package\',\n  \'Wine\',\n  \'Baby\',\n  \'Scissors\',\n  \'Briefcase\',\n  \'CreditCard\',\n  \'PiggyBank\',\n  \'Sparkles\',\n];\n\nexport const PRESET_COLORS = [\n  \'#F59E0B\', // Amber / Orange\n  \'#10B981\', // Emerald / Green\n  \'#EC4899\', // Pink\n  \'#6366F1\', // Indigo\n  \'#3B82F6\', // Blue\n  \'#8B5CF6\', // Purple\n  \'#06B6D4\', // Cyan\n  \'#F43F5E\', // Rose\n  \'#14B8A6\', // Teal\n  \'#EAB308\', // Yellow\n  \'#84CC16\', // Lime\n  \'#64748B\', // Slate\n];\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
