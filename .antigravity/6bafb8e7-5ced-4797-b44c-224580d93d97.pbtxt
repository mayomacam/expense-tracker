    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n"
      replacement_content: "@import \"tailwindcss\";\n\n:root {\n  --bg: #09090b;\n  --card: #111114;\n  --card-hover: #18181c;\n  --accent: #c1ff72;\n  --accent-muted: rgba(193, 255, 114, 0.15);\n  --muted: #71717a;\n  --danger: #ff5f5f;\n  --border: rgba(255, 255, 255, 0.07);\n}\n\nbody {\n  background-color: var(--bg);\n  color: #f4f4f5;\n  font-family: \'Inter\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  margin: 0;\n  min-height: 100vh;\n}\n\n.glow-bg {\n  position: fixed;\n  top: -10%;\n  left: 5%;\n  width: 500px;\n  height: 500px;\n  background: radial-gradient(circle, rgba(193, 255, 114, 0.06) 0%, rgba(193, 255, 114, 0) 70%);\n  pointer-events: none;\n  z-index: 0;\n}\n\n.glow-bg-secondary {\n  position: fixed;\n  bottom: 0%;\n  right: 5%;\n  width: 450px;\n  height: 450px;\n  background: radial-gradient(circle, rgba(99, 102, 241, 0.05) 0%, rgba(99, 102, 241, 0) 70%);\n  pointer-events: none;\n  z-index: 0;\n}\n\n.glass-card {\n  background: var(--card);\n  border: 1px solid var(--border);\n  backdrop-filter: blur(12px);\n  border-radius: 16px;\n}\n\n.stat-value {\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -0.5px;\n}\n\n.tag {\n  font-size: 10px;\n  text-transform: uppercase;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  padding: 3px 8px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid var(--border);\n  color: #a1a1aa;\n}\n\n/* Custom dark scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: rgba(0, 0, 0, 0.2);\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.12);\n  border-radius: 3px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(193, 255, 114, 0.3);\n}\n"
    }
