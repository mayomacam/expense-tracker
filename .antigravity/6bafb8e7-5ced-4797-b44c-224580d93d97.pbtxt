er-800 mb-1\">\n                <span className=\"font-semibold uppercase tracking-wide\">Prorated Math Preview</span>\n                <span>{getMonthName(selectedMonth)} ({daysInMon} days)</span>\n              </div>\n              <div className=\"flex items-baseline justify-between mt-1\">\n                <div>\n                  <span className=\"text-2xl font-bold text-amber-900\">\n                    {formatCurrency(calculatedDailyLimit, settings.currency)}\n                  </span>\n                  <span className=\"text-xs text-amber-700 font-medium ml-1\">/ day limit</span>\n                </div>\n                <div className=\"text-right text-xs text-amber-800\">\n                  <div>\n                    Monthly Cap: <strong>{formatCurrency(numMax, settings.currency)}</strong>\n                  </div>\n                  {rolloverEnabled && numRoll !== 0 && (\n                    <div className=\"text-[11px] text-amber-600\">\n                      Rollover: {numRoll > 0 ? \'+\' : \'\'}{formatCurrency(numRoll, settings.currency)}\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n\n            {/* Custom Item Name & Max Spend */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                  Item / Tracking Name *\n                </label>\n                <input\n                  id=\"prorated-name-input\"\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Snacks, Coffee, Dining Out\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:bg-white focus:outline-none focus:border-amber-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                  Monthly Max Spend ({settings.currency}) *\n                </label>\n                <div className=\"relative\">\n                  <span className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-medium\">\n                    {settings.currency}\n                  </span>\n                  <input\n                    id=\"prorated-monthly-spend-input\"\n                    type=\"number\"\n                    step=\"1\"\n                    min=\"1\"\n                    required\n                    placeholder=\"500\"\n                    value={monthlyMaxSpend}\n                    onChange={(e) => setMonthlyMaxSpend(e.target.value)}\n                    className=\"w-full pl-8 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-semibold text-sm focus:bg-white focus:outline-none focus:border-amber-500\"\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Category Association */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Link to Category (Optional)\n              </label>\n              <select\n                id=\"prorated-category-select\"\n                value={categoryId}\n                onChange={(e) => setCategoryId(e.target.value)}\n                className=\"w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-xs focus:bg-white focus:outline-none focus:border-amber-500\"\n              >\n                <option value=\"\">-- Match by Name or Tags --</option>\n                {categories.map((cat) => (\n                  <option key={cat.id} value={cat.id}>\n                    {cat.name}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Target Tags */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Target Tags (Comma separated)\n              </label>\n              <input\n                id=\"prorated-tags-input\"\n                type=\"text\"\n                placeholder=\"snacks, coffee_break, pastry, chips\"\n                value={targetTagsStr}\n                onChange={(e) => setTargetTagsStr(e.target.value)}\n                className=\"w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-xs focus:bg-white focus:outline-none focus:border-amber-500\"\n              />\n              <p className=\"text-[11px] text-slate-400 mt-1\">\n                Any expense with these tags will automatically count against this prorated daily budget.\n              </p>\n            </div>\n\n            {/* Budget Rollover Settings */}\n            <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <ArrowRightLeft className=\"w-4 h-4 text-indigo-600\" />\n                  <div>\n                    <span className=\"text-xs font-semibold text-slate-800 block\">\n                      Budget Rollover Settings\n                    </span>\n                    <span className=\"text-[11px] text-slate-500\">\n                      Carry unspent surplus or overage into next month\n                    </span>\n                  </div>\n                </div>\n                <input\n                  id=\"prorated-rollover-toggle\"\n                  type=\"checkbox\"\n                  checked={rolloverEnabled}\n                  onChange={(e) => setRolloverEnabled(e.target.checked)}\n                  className=\"w-4 h-4 text-amber-600 rounded-sm border-slate-300 focus:ring-amber-500\"\n                />\n              </div>\n\n              {rolloverEnabled && (\n                <div className=\"pt-2 border-t border-slate-200\">\n                  <label className=\"block text-[11px] font-semibold text-slate-600 mb-1\">\n                    Rollover Amount from Previous Month ({settings.currency})\n                  </label>\n                  <input\n                    id=\"prorated-rollover-amount-input\"\n                    type=\"number\"\n                    step=\"0.01\"\n                    placeholder=\"0.00 (Positive for surplus, negative for deficit)\"\n                    value={rolloverAmount}\n                    onChange={(e) => setRolloverAmount(e.target.value)}\n                    className=\"w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-none focus:border-amber-500\"\n                  />\n                </div>\n              )}\n            </div>\n\n            {/* Daily Alert Threshold */}\n            <div>\n              <div className=\"flex items-center justify-between text-xs font-semibold text-slate-700 mb-1\">\n                <span className=\"flex items-center gap-1.5\">\n                  <AlertTriangle className=\"w-3.5 h-3.5 text-amber-500\" />\n                  Daily Limit Alert Trigger\n                </span>\n                <span className=\"text-amber-700 font-bold\">{alertThresholdPercent}% of limit</span>\n              </div>\n              <input\n                id=\"prorated-alert-slider\"\n                type=\"range\"\n                min=\"50\"\n                max=\"120\"\n                step=\"5\"\n                value={alertThresholdPercent}\n                onChange={(e) => setAlertThresholdPercent(e.target.value)}\n                className=\"w-full accent-amber-600 h-2 bg-slate-200 rounded-lg cursor-pointer\"\n              />\n              <div className=\"flex justify-between text-[10px] text-slate-400 mt-1\">\n                <span>50% (Early Warning)</span>\n                <span>100% (Exact Limit)</span>\n                <span>120% (Relaxed)</span>\n              </div>\n            </div>\n\n            {/* Submit Actions */}\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                id=\"cancel-prorated-btn\"\n                onClick={onClose}\n                className=\"px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800 rounded-xl hover:bg-slate-100 transition-colors\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                id=\"save-prorated-btn\"\n                className=\"px-5 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-xs transition-colors flex items-center gap-1.5\"\n              >\n                <Check className=\"w-3.5 h-3.5\" />\n                {editingRule ? \'Update Tracker\' : \'Activate Prorated Limit\'}\n              </button>\n            </div>\n          </form>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );"
