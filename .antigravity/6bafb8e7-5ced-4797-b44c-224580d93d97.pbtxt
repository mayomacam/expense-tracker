        lines {
          text: "  update(id: string, updates: Partial<Transaction>): Transaction | null {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const existing = this.getById(id);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!existing) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
