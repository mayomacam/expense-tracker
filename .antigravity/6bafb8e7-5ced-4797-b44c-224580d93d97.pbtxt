  file_change {
    absolute_path_uri: "file:///src/context/ExpenseContext.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { createContext, useContext, useState, useEffect, useMemo, ReactNode } from \'react\';\nimport {\n  Transaction,\n  Category,\n  ProratedBudgetRule,\n  SavingsGoal,\n  DebtItem,\n  RecurringItem,\n  BudgetAlert,\n  UserSettings,\n  TransactionType,\n} from \'../types\';\nimport { getInitialSeedData } from \'../data/seedData\';\nimport { evaluateAllAlerts } from \'../utils/budgetCalculations\';\nimport { getCurrentYearMonth } from \'../utils/formatters\';\n\ninterface ExpenseContextType {\n  transactions: Transaction[];\n  categories: Category[];\n  proratedRules: ProratedBudgetRule[];\n  savingsGoals: SavingsGoal[];\n  debts: DebtItem[];\n  recurring: RecurringItem[];\n  alerts: BudgetAlert[];\n  unreadAlertCount: number;\n  settings: UserSettings;\n  selectedMonth: string;\n  setSelectedMonth: (month: string) => void;\n\n  // Transaction Actions\n  addTransaction: (tx: Omit<Transaction, \'id\'>) => Transaction;\n  updateTransaction: (id: string, tx: Partial<Transaction>) => void;\n  deleteTransaction: (id: string) => void;\n  importTransactions: (txs: Transaction[]) => void;\n\n  // Category Actions\n  addCategory: (cat: Omit<Category, \'id\'>) => Category;\n  updateCategory: (id: string, cat: Partial<Category>) => void;\n  deleteCategory: (id: string) => void;\n\n  // Prorated Budget Rule Actions\n  addProratedRule: (rule: Omit<ProratedBudgetRule, \'id\'>) => ProratedBudgetRule;\n  updateProratedRule: (id: string, rule: Partial<ProratedBudgetRule>) => void;\n  deleteProratedRule: (id: string) => void;\n\n  // Savings Goal Actions\n  addSavingsGoal: (goal: Omit<SavingsGoal, \'id\' | \'currentAmount\' | \'history\'>) => SavingsGoal;\n  updateSavingsGoal: (id: string, goal: Partial<SavingsGoal>) => void;\n  deleteSavingsGoal: (id: string) => void;\n  addSavingsContribution: (goalId: string, amount: number, note?: string, type?: \'deposit\' | \'withdrawal\') => void;\n\n  // Debt Actions\n  addDebt: (debt: Omit<DebtItem, \'id\' | \'remainingBalance\' | \'payments\'>) => DebtItem;\n  updateDebt: (id: string, debt: Partial<DebtItem>) => void;\n  deleteDebt: (id: string) => void;\n  recordDebtPayment: (debtId: string, amount: number, note?: string) => void;\n\n  // Recurring Actions\n  addRecurringItem: (item: Omit<RecurringItem, \'id\'>) => RecurringItem;\n  updateRecurringItem: (id: string, item: Partial<RecurringItem>) => void;\n  deleteRecurringItem: (id: string) => void;\n  applyRecurringForMonth: (month: string) => { addedCount: number };\n\n  // Alert Actions\n  markAlertAsRead: (alertId: string) => void;\n  markAllAlertsAsRead: () => void;\n  clearAlerts: () => void;\n  triggerTestNotification: (title?: string, message?: string) => void;\n\n  // Settings Actions\n  updateSettings: (newSettings: Partial<UserSettings>) => void;\n  resetToDefaultData: () => void;\n\n  // Tags\n  allTags: string[];\n}\n\nconst ExpenseContext = createContext<ExpenseContextType | undefined>(undefined);\n\nconst STORAGE_KEYS = {\n  TRANSACTIONS: \'omnibudget_transactions_v2\',\n  CATEGORIES: \'omnibudget_categories_v2\',\n  PRORATED_RULES: \'omnibudget_prorated_rules_v2\',\n  SAVINGS: \'omnibudget_savings_v2\',\n  DEBTS: \'omnibudget_debts_v2\',\n  RECURRING: \'omnibudget_recurring_v2\',\n  SETTINGS: \'omnibudget_settings_v2\',\n  READ_ALERTS: \'omnibudget_read_alerts_v2\',\n};\n\nexport const ExpenseProvider: React.FC<{ children: ReactNode }> = ({ children }) => {\n  const seed = useMemo(() => getInitialSeedData(), []);\n\n  // Initialize state with localStorage or fallback to seedData\n  const [transactions, setTransactions] = useState<Transaction[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.TRANSACTIONS);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading transactions\', e);\n      }\n    }\n    return seed.transactions;\n  });\n\n  const [categories, setCategories] = useState<Category[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.CATEGORIES);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading categories\', e);\n      }\n    }\n    return seed.categories;\n  });\n\n  const [proratedRules, setProratedRules] = useState<ProratedBudgetRule[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.PRORATED_RULES);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading prorated rules\', e);\n      }\n    }\n    return seed.proratedRules;\n  });\n\n  const [savingsGoals, setSavingsGoals] = useState<SavingsGoal[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.SAVINGS);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading savings\', e);\n      }\n    }\n    return seed.savingsGoals;\n  });\n\n  const [debts, setDebts] = useState<DebtItem[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.DEBTS);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading debts\', e);\n      }\n    }\n    return seed.debts;\n  });\n\n  const [recurring, setRecurring] = useState<RecurringItem[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.RECURRING);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading recurring\', e);\n      }\n    }\n    return seed.recurring;\n  });\n\n  const [settings, setSettings] = useState<UserSettings>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.SETTINGS);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading settings\', e);\n      }\n    }\n    return seed.settings;\n  });\n\n  const [readAlertIds, setReadAlertIds] = useState<string[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.READ_ALERTS);\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch (e) {\n        console.error(\'Error loading read alerts\', e);\n      }\n    }\n    return [];\n  });\n\n  const [selectedMonth, setSelectedMonth] = useState<string>(\n    settings.selectedMonth || getCurrentYearMonth()\n  );\n\n  // Sync to LocalStorage\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.TRANSACTIONS, JSON.stringify(transactions));\n  }, [transactions]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.CATEGORIES, JSON.stringify(categories));\n  }, [categories]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.PRORATED_RULES, JSON.stringify(proratedRules));\n  }, [proratedRules]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.SAVINGS, JSON.stringify(savingsGoals));\n  }, [savingsGoals]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.DEBTS, JSON.stringify(debts));\n  }, [debts]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.RECURRING, JSON.stringify(recurring));\n  }, [recurring]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(settings));\n  }, [settings]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.READ_ALERTS, JSON.stringify(readAlertIds));\n  }, [readAlertIds]);\n\n  // Request browser notification permission if enabled\n  useEffect(() => {\n    if (settings.pushNotificationsEnabled && \'Notification\' in window) {\n      if (Notification.permission === \'default\') {\n        Notification.requestPermission();\n      }\n    }\n  }, [settings.pushNotificationsEnabled]);\n\n  // Derive dynamic alerts based on live state\n  const alerts: BudgetAlert[] = useMemo(() => {\n    const rawAlerts = evaluateAllAlerts(\n      transactions,\n      categories,\n      proratedRules,\n      recurring,\n      debts,\n      savingsGoals,\n      settings,\n      selectedMonth\n    );\n\n    return rawAlerts.map((alert) => ({\n      ...alert,\n      read: readAlertIds.includes(alert.id),\n    }));\n  }, [\n    transactions,\n    categories,\n    proratedRules,\n    recurring,\n    debts,\n    savingsGoals,\n    settings,\n    selectedMonth,\n    readAlertIds,\n  ]);\n\n  const unreadAlertCount = useMemo(() => {\n    return alerts.filter((a) => !a.read).length;\n  }, [alerts]);\n\n  // All distinct tags\n  const allTags = useMemo(() => {\n    const tagSet = new Set<string>();\n    transactions.forEach((t) => (t.tags || []).forEach((tag) => tagSet.add(tag)));\n    recurring.forEach((r) => (r.tags || []).forEach((tag) => tagSet.add(tag)));\n    return Array.from(tagSet).sort();\n  }, [transactions, recurring]);\n\n  // Transaction CRUD\n  const addTransaction = (tx: Omit<Transaction, \'id\'>): Transaction => {\n    const newTx: Transaction = {\n      ...tx,\n      id: `tx-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,\n    };\n    setTransactions((prev) => [newTx, ...prev]);\n\n    // Check if adding this transaction should trigger an automated notification\n    if (settings.pushNotificationsEnabled && \'Notification\' in window && Notification.permission === \'granted\') {\n      const categoryObj = categories.find((c) => c.id === tx.category);\n      if (tx.type === \'expense\' && tx.amount > 50) {\n        new Notification(`Logged Expense: ${tx.title}`, {\n          body: `Spent ${settings.currency}${tx.amount.toFixed(2)} under ${categoryObj?.name || \'General\'}.`,\n        });\n      }\n    }\n\n    return newTx;\n  };\n\n  const updateTransaction = (id: string, updated: Partial<Transaction>) => {\n    setTransactions((prev) =>\n      prev.map((t) => (t.id === id ? { ...t, ...updated } : t))\n    );\n  };\n\n  const deleteTransaction = (id: string) => {\n    setTransactions((prev) => prev.filter((t) => t.id !== id));\n  };\n\n  const importTransactions = (imported: Transaction[]) => {\n    setTransactions((prev) => [...imported, ...prev]);\n  };\n\n  // Category CRUD\n  const addCategory = (cat: Omit<Category, \'id\'>): Category => {\n    const newCat: Category = {\n      ...cat,\n      id: `cat-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,\n      isCustom: true,\n    };\n    setCategories((prev) => [...prev, newCat]);\n    return newCat;\n  };\n\n  const updateCategory = (id: string, updated: Partial<Category>) => {\n    setCategories((prev) =>\n      prev.map((c) => (c.id === id ? { ...c, ...updated } : c))\n    );\n  };\n\n  const deleteCategory = (id: string) => {\n    setCategories((prev) => prev.filter((c) => c.id !== id));\n  };\n\n  // Prorated Budget Rule CRUD\n  const addProratedRule = (rule: Omit<ProratedBudgetRule, \'id\'>): ProratedBudgetRule => {\n    const newRule: ProratedBudgetRule = {\n      ...rule,\n      id: `rule-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,\n    };\n    setProratedRules((prev) => [...prev, newRule]);\n    return newRule;\n  };\n\n  const updateProratedRule = (id: string, updated: Partial<ProratedBudgetRule>) => {\n    setProratedRules((prev) =>\n      prev.map((r) => (r.id === id ? { ...r, ...updated } : r))\n    );\n  };\n\n  const deleteProratedRule = (id: string) => {\n    setProratedRules((prev) => prev.filter((r) => r.id !== id));\n  };\n\n  // Savings Goal CRUD\n  const addSavingsGoal = (\n    goal: Omit<SavingsGoal, \'id\' | \'currentAmount\' | \'history\'>\n  ): SavingsGoal => {\n    const newGoal: SavingsGoal = {\n      ...goal,\n      id: `goal-${Date.now()}`,\n      currentAmount: 0,\n      history: [],\n    };\n    setSavingsGoals((prev) => [...prev, newGoal]);\n    return newGoal;\n  };\n\n  const updateSavingsGoal = (id: string, updated: Partial<SavingsGoal>) => {\n    setSavingsGoals((prev) =>\n      prev.map((g) => (g.id === id ? { ...g, ...updated } : g))\n    );\n  };\n\n  const deleteSavingsGoal = (id: string) => {\n    setSavingsGoals((prev) => prev.filter((g) => g.id !== id));\n  };\n\n  const addSavingsContribution = (\n    goalId: string,\n    amount: number,\n    note?: string,\n    type: \'deposit\' | \'withdrawal\' = \'deposit\'\n  ) => {\n    const contributionAmount = type === \'deposit\' ? Math.abs(amount) : -Math.abs(amount);\n\n    setSavingsGoals((prev) =>\n      prev.map((g) => {\n        if (g.id !== goalId) return g;\n        const newBalance = Math.max(0, g.currentAmount + contributionAmount);\n        const newHistoryItem = {\n          id: `h-${Date.now()}`,\n          date: new Date().toISOString().split(\'T\')[0],\n          amount: Math.abs(amount),\n          note: note || (type === \'deposit\' ? \'Added savings funds\' : \'Withdrawn savings funds\'),\n          type,\n        };\n        return {\n          ...g,\n          currentAmount: newBalance,\n          history: [newHistoryItem, ...(g.history || [])],\n        };\n      })\n    );\n  };\n\n  // Debt CRUD & Payments\n  const addDebt = (\n    debt: Omit<DebtItem, \'id\' | \'remainingBalance\' | \'payments\'>\n  ): DebtItem => {\n    const newDebt: DebtItem = {\n      ...debt,\n      id: `debt-${Date.now()}`,\n      remainingBalance: debt.totalPrincipal,\n      payments: [],\n    };\n    setDebts((prev) => [...prev, newDebt]);\n    return newDebt;\n  };\n\n  const updateDebt = (id: string, updated: Partial<DebtItem>) => {\n    setDebts((prev) =>\n      prev.map((d) => (d.id === id ? { ...d, ...updated } : d))\n    );\n  };\n\n  const deleteDebt = (id: string) => {\n    setDebts((prev) => prev.filter((d) => d.id !== id));\n  };\n\n  const recordDebtPayment = (debtId: string, amount: number, note?: string) => {\n    const payAmount = Math.abs(amount);\n    setDebts((prev) =>\n      prev.map((d) => {\n        if (d.id !== debtId) return d;\n        // Approximate interest calculation for the month: (Balance * Rate) / 1200\n        const monthlyInterest = (d.remainingBalance * (d.interestRate / 100)) / 12;\n        const actualInterestPaid = Math.min(payAmount, monthlyInterest);\n        const principalPaid = Math.max(0, payAmount - actualInterestPaid);\n        const newBalance = Math.max(0, d.remainingBalance - principalPaid);\n\n        const newPayment = {\n          id: `pay-${Date.now()}`,\n          date: new Date().toISOString().split(\'T\')[0],\n          amount: payAmount,\n          principalPaid: Number(principalPaid.toFixed(2)),\n          interestPaid: Number(actualInterestPaid.toFixed(2)),\n          note: note || \'Monthly debt installment\',\n        };\n\n        return {\n          ...d,\n          remainingBalance: Number(newBalance.toFixed(2)),\n          payments: [newPayment, ...(d.payments || [])],\n        };\n      })\n    );\n  };\n\n  // Recurring CRUD & Auto-populate\n  const addRecurringItem = (item: Omit<RecurringItem, \'id\'>): RecurringItem => {\n    const newItem: RecurringItem = {\n      ...item,\n      id: `rec-${Date.now()}`,\n    };\n    setRecurring((prev) => [...prev, newItem]);\n    return newItem;\n  };\n\n  const updateRecurringItem = (id: string, updated: Partial<RecurringItem>) => {\n    setRecurring((prev) =>\n      prev.map((r) => (r.id === id ? { ...r, ...updated } : r))\n    );\n  };\n\n  const deleteRecurringItem = (id: string) => {\n    setRecurring((prev) => prev.filter((r) => r.id !== id));\n  };\n\n  const applyRecurringForMonth = (targetMonth: string): { addedCount: number } => {\n    let count = 0;\n    const [year, mon] = targetMonth.split(\'-\');\n    const newTxs: Transaction[] = [];\n\n    recurring.forEach((item) => {\n      if (!item.isActive) return;\n\n      // Check if already applied for this month\n      const dayStr = String(Math.min(28, item.dayOfMonth)).padStart(2, \'0\');\n      const itemDate = `${targetMonth}-${dayStr}`;\n\n      const alreadyExists = transactions.some(\n        (t) =>\n          t.date.startsWith(targetMonth) &&\n          t.title === item.title &&\n          t.amount === item.amount\n      );\n\n      if (!alreadyExists) {\n        newTxs.push({\n          id: `tx-rec-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,\n          title: item.title,\n          amount: item.amount,\n          type: item.type,\n          category: item.category,\n          date: itemDate,\n          tags: [...item.tags, \'recurring_applied\'],\n          paymentMethod: item.paymentMethod,\n          isRecurring: true,\n          notes: `Auto-generated recurring ${item.type} for ${targetMonth}`,\n        });\n        count++;\n      }\n    });\n\n    if (newTxs.length > 0) {\n      setTransactions((prev) => [...newTxs, ...prev]);\n    }\n\n    return { addedCount: count };\n  };\n\n  // Alert Actions\n  const markAlertAsRead = (alertId: string) => {\n    setReadAlertIds((prev) => (prev.includes(alertId) ? prev : [...prev, alertId]));\n  };\n\n  const markAllAlertsAsRead = () => {\n    const allIds = alerts.map((a) => a.id);\n    setReadAlertIds(allIds);\n  };\n\n  const clearAlerts = () => {\n    const allIds = alerts.map((a) => a.id);\n    setReadAlertIds(allIds);\n  };\n\n  const triggerTestNotification = (\n    title = \'Budget Alert Notification\',\n    message = \'Your prorated daily limit on Snacks was exceeded by +$12.50 today.\'\n  ) => {\n    if (\'Notification\' in window) {\n      if (Notification.permission === \'granted\') {\n        new Notification(title, { body: message });\n      } else if (Notification.permission !== \'denied\') {\n        Notification.requestPermission().then((permission) => {\n          if (permission === \'granted\') {\n            new Notification(title, { body: message });\n          }\n        });\n      }\n    }\n  };\n\n  const updateSettings = (newSettings: Partial<UserSettings>) => {\n    setSettings((prev) => ({ ...prev, ...newSettings }));\n  };\n\n  const resetToDefaultData = () => {\n    const fresh = getInitialSeedData();\n    setTransactions(fresh.transactions);\n    setCategories(fresh.categories);\n    setProratedRules(fresh.proratedRules);\n    setSavingsGoals(fresh.savingsGoals);\n    setDebts(fresh.debts);\n    setRecurring(fresh.recurring);\n    setSettings(fresh.settings);\n    setReadAlertIds([]);\n    setSelectedMonth(fresh.settings.selectedMonth);\n    localStorage.clear();\n  };\n\n  return (\n    <ExpenseContext.Provider\n      value={{\n        transactions,\n        categories,\n        proratedRules,\n        savingsGoals,\n        debts,\n        recurring,\n        alerts,\n        unreadAlertCount,\n        settings,\n        selectedMonth,\n        setSelectedMonth,\n        addTransaction,\n        updateTransaction,\n        deleteTransaction,\n        importTransactions,\n        addCategory,\n        updateCategory,\n        deleteCategory,\n        addProratedRule,\n        updateProratedRule,\n        deleteProratedRule,\n        addSavingsGoal,\n        updateSavingsGoal,\n        deleteSavingsGoal,\n        addSavingsContribution,\n        addDebt,\n        updateDebt,\n        deleteDebt,\n        recordDebtPayment,\n        addRecurringItem,\n        updateRecurringItem,\n        deleteRecurringItem,\n        applyRecurringForMonth,\n        markAlertAsRead,\n        markAllAlertsAsRead,\n        clearAlerts,\n        triggerTestNotification,\n        updateSettings,\n        resetToDefaultData,\n        allTags,\n      }}\n    >\n      {children}\n    </ExpenseContext.Provider>\n  );\n};\n\nexport const useExpense = (): ExpenseContextType => {\n  const context = useContext(ExpenseContext);\n  if (!context) {\n    throw new Error(\'useExpense must be used within an ExpenseProvider\');\n  }\n  return context;\n};\n"
    }
