import React from 'react';
import { Target, CheckCircle, AlertCircle } from 'lucide-react';
import { useExpense } from '../../context/ExpenseContext';
import { calculateNeedsWantsBreakdown } from '../../utils/needsWantsBreakdown';
import { formatCurrency } from '../../utils/formatters';

export const NeedsVsWantsWidget: React.FC = () => {
  const { transactions, settings } = useExpense();
  const summary = calculateNeedsWantsBreakdown(transactions, settings.selectedMonth);

  return (
    <div className="rounded-xl bg-[#141419] border border-zinc-800 p-4 space-y-3">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          <div className="p-1.5 rounded-md bg-blue-500/20 text-blue-400">
            <Target className="w-3.5 h-3.5" />
          </div>
          <div>
            <h4 className="text-xs font-semibold text-white">Need vs. Want Ratio</h4>
            <p className="text-[10px] text-zinc-400">Discretionary impulse vs. essentials</p>
          </div>
        </div>

        <div className="text-[11px] font-medium px-2 py-0.5 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-300">
          Total: {formatCurrency(summary.totalDiscretionary, settings.currency)}
        </div>
      </div>

      {/* Visual Dual Progress Bar */}
      <div className="space-y-1">
        <div className="flex h-3 w-full rounded-full overflow-hidden bg-zinc-800">
          <div
            className="bg-emerald-500 transition-all duration-500"
            style={{ width: `${summary.needsPercentage}%` }}
            title={`Needs: ${summary.needsPercentage}%`}
          />
          <div
            className="bg-amber-400 transition-all duration-500"
            style={{ width: `${summary.wantsPercentage}%` }}
            title={`Wants: ${summary.wantsPercentage}%`}
          />
        </div>

        <div className="flex justify-between text-[11px] text-zinc-400 pt-1">
          <div className="flex items-center gap-1">
            <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block" />
            <span>
              Needs: <strong className="text-emerald-400">{formatCurrency(summary.needsTotal, settings.currency)}</strong> ({summary.needsPercentage}%)
            </span>
          </div>
          <div className="flex items-center gap-1">
            <span className="w-2 h-2 rounded-full bg-amber-400 inline-block" />
            <span>
              Wants: <strong className="text-amber-400">{formatCurrency(summary.wantsTotal, settings.currency)}</strong> ({summary.wantsPercentage}%)
            </span>
          </div>
        </div>
      </div>

      {/* Insight Highlight Banner */}
      <div className="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-xs flex items-center gap-2">
        {summary.wantsPercentage > 35 ? (
          <>
            <AlertCircle className="w-4 h-4 text-amber-400 shrink-0" />
            <span className="text-zinc-300">
              You spent <strong className="text-amber-300">{formatCurrency(summary.wantsTotal, settings.currency)}</strong> on non-essential &apos;Wants&apos; this month ({summary.wantsPercentage}%).
            </span>
          </>
        ) : (
          <>
            <CheckCircle className="w-4 h-4 text-emerald-400 shrink-0" />
            <span className="text-zinc-300">
              High discipline! Essential needs account for <strong className="text-emerald-300">{summary.needsPercentage}%</strong> of your discretionary spend this month.
            </span>
          </>
        )}
      </div>
    </div>
  );
};
