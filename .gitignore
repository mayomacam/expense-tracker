# Dependencies
node_modules/
js_version/node_modules/
vendor/

# Build artifacts
dist/
js_version/dist/
*.zip

# Environment & Configs
.env
.env.*
!.env.example

# Logs & Temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
