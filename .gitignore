# ==============================================================================
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.key
.secret_reset_password.key

# Ignore all database files in root data/ and js_version/data/
data/*
!data/.htaccess
!data/.gitkeep
js_version/data/*
!js_version/data/.htaccess
!js_version/data/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
